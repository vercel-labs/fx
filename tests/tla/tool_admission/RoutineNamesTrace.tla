------------------------- MODULE RoutineNamesTrace -------------------------
(***************************************************************************)
(* Trace validation: replays one `fx ask` turn observed from the real      *)
(* binary through RoutineNames' own actions.                               *)
(*                                                                          *)
(* RoutineNamesObserved is generated by                                     *)
(* ../drivers/tool_admission/driver.ts. It defines Observed, one turn:     *)
(*   [start |-> BOOLEAN, moved |-> BOOLEAN, brokenReplay |-> BOOLEAN,      *)
(*    failFirstCapture |-> BOOLEAN, parallel |-> BOOLEAN,                  *)
(*    steps |-> <<step, ...>>]                                              *)
(* where start says whether the startup files define git when fx starts,  *)
(* moved whether they set ZDOTDIR to a folder fx's own environment does   *)
(* not name, brokenReplay whether every snapshot replay fails before its  *)
(* command starts, failFirstCapture whether the first capture fails,      *)
(* parallel whether each call belongs to its own subagent, and each step  *)
(* is one shell call, in the order the agent made it:                     *)
(*   [kind |-> "git" | "nonroutine", reload |-> BOOLEAN,                   *)
(*    effect |-> "none" | "alias_on" | "alias_off",                        *)
(*    reviewed |-> BOOLEAN,                                                 *)
(*    outcome |-> "alias" | "real" | "refused" | "held"]                   *)
(* Step i is command i. The agent runs one call at a time, so call i acts  *)
(* only after call i - 1 finished. A parallel turn is the exception: the   *)
(* subagents start together, so TLC picks the order in which the calls     *)
(* act, and every call is approved before any call starts running. The     *)
(* shared capture ends their admission waits at once, and the call that    *)
(* runs first must start a shell and replay before it can fail the         *)
(* generation, so the driver does not observe that order. Captures are     *)
(* fx's own and not observed, so TLC chooses when they finish; the only    *)
(* capture that fails is the first, in a turn that plants the failure.     *)
(* Nothing outside the turn edits the startup files.                       *)
(*                                                                          *)
(* The turn is accepted when TLC violates the sentinel NotAllMatched,      *)
(* which is reachable only after every step finished with the observed    *)
(* review and outcome. No violation means the model cannot produce it.     *)
(***************************************************************************)
EXTENDS RoutineNames, RoutineNamesObserved, Sequences, TLC

TraceCmds == 1..Len(Observed.steps)

VARIABLE step
traceVars == <<vars, step>>

S == Observed.steps[step]
InTurn == step <= Len(Observed.steps)

TraceInit == InitWith(Observed.start, Observed.moved) /\ step = 1

\* Only the current call acts, and the reviewer decides as observed.
SerialStep ==
    /\ InTurn
    /\ \/ Admit(step, S.kind, S.reload, S.effect)
       \/ AdmitDecide(step)
       \/ Reviewed(step, S.outcome # "held")
       \/ StartRun(step)
       \/ RunDecide(step)
       \/ ~Observed.brokenReplay /\ Replay(step)
       \/ ReplayFail(step)
    /\ UNCHANGED step

\* A parallel turn: any call acts, but none starts running before every call
\* is approved.
AllApproved == \A d \in TraceCmds : pc[d] \notin {"idle", "admitting", "reviewing"}

ParallelStep(c) ==
    /\ InTurn
    /\ \/ Admit(c, Observed.steps[c].kind, Observed.steps[c].reload, Observed.steps[c].effect)
       \/ AdmitDecide(c)
       \/ Reviewed(c, Observed.steps[c].outcome # "held")
       \/ AllApproved /\ StartRun(c)
       \/ RunDecide(c)
       \/ ~Observed.brokenReplay /\ Replay(c)
       \/ ReplayFail(c)
    /\ UNCHANGED step

CallStep == IF Observed.parallel THEN \E c \in TraceCmds : ParallelStep(c) ELSE SerialStep

OwnerStep ==
    /\ CaptureOk \/ (Observed.failFirstCapture /\ captures = 1 /\ CaptureFail)
    /\ UNCHANGED step

StepMatched ==
    /\ InTurn
    /\ ~Observed.parallel
    /\ pc[step] = "done"
    /\ outcome[step] = S.outcome
    /\ (auth[step] = "review") = S.reviewed
    /\ PrintT(<<"FXT_MATCHED", step>>)
    /\ step' = step + 1
    /\ UNCHANGED vars

\* A parallel turn matches when every call finished as observed.
ParallelMatched ==
    /\ InTurn
    /\ Observed.parallel
    /\ \A c \in TraceCmds :
          /\ pc[c] = "done"
          /\ outcome[c] = Observed.steps[c].outcome
          /\ (auth[c] = "review") = Observed.steps[c].reviewed
    /\ PrintT(<<"FXT_MATCHED", "all">>)
    /\ step' = Len(Observed.steps) + 1
    /\ UNCHANGED vars

TraceNext == CallStep \/ OwnerStep \/ StepMatched \/ ParallelMatched

NotAllMatched == InTurn
=============================================================================
