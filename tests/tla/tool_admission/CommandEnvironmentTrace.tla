---------------------- MODULE CommandEnvironmentTrace ----------------------
(***************************************************************************)
(* Trace validation: replays shell calls observed from the real fx binary  *)
(* through CommandEnvironment's own actions.                               *)
(*                                                                         *)
(* CommandEnvironmentObserved is generated by                              *)
(* tests/tla/drivers/tool_admission/driver.ts. It defines Observed, a      *)
(* sequence of records [call, reviewed, packet, reviewerCalls, decision,   *)
(* ran, startupRan]: the call fx ran (from its permission identity), what  *)
(* the review packet said about the interpreter, how many reviewer         *)
(* requests the fake gateway counted, the outcome, whether the command     *)
(* ran, and whether the user's startup alias ran before it.                *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has finished a call in exactly the observed way. The run is       *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS CommandEnvironment, CommandEnvironmentObserved, Sequences

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ Init

Step ==
    /\ k <= Len(Observed)
    /\ \/ Propose(Observed[k].call)
       \/ RunUnreviewed
       \/ BuildRequest
       \/ Serialize
       \/ HoldIncomplete
       \/ Observed[k].decision \in {"clear", "caution"} /\ Review(Observed[k].decision)
       \/ Execute
       \/ Hold
    /\ UNCHANGED k

Matches(o) ==
    /\ phase = "done"
    /\ call = o.call
    /\ reviewed = o.reviewed
    /\ packet = o.packet
    /\ reviewerCalls = o.reviewerCalls
    /\ decision = o.decision
    /\ ran = o.ran
    /\ startupRan = o.startupRan

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ Continue

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
