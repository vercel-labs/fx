---------------------- MODULE ShellSnapshotCaptureTrace ----------------------
(***************************************************************************)
(* Trace validation: replays runs observed from the real fx binary through *)
(* ShellSnapshotCapture's own actions.                                     *)
(*                                                                          *)
(* ShellSnapshotCaptureObserved is generated by                            *)
(* tests/tla/drivers/terminal/capture.ts. It defines Observed, a sequence  *)
(* of cases. Each case gives the login shell, whether fx inherited a       *)
(* ZDOTDIR, what the startup files do with ZDOTDIR, the state of each      *)
(* function they define, and the events of one `fx ask` run in order: a    *)
(* command with what it saw, or an edit of the startup file the shell      *)
(* reads.                                                                  *)
(*                                                                          *)
(* Cases are replayed in order. The index k advances only when the model   *)
(* has produced every event of the case in exactly the observed way. The   *)
(* runs are ACCEPTED when TLC violates NotAllMatched, which is reachable    *)
(* only after every case matched. A completed search means REJECTED.       *)
(***************************************************************************)
EXTENDS ShellSnapshotCapture, ShellSnapshotCaptureObserved

VARIABLES k, pos
traceVars == <<vars, k, pos>>

InitWith(c) ==
    /\ shell = c.shell
    /\ inherited = c.inherited
    /\ zmode = c.zmode
    /\ fstate = c.fstate
    /\ ver = [d \in Dirs |-> 0]
    /\ snap = NoSnap
    /\ captures = 0
    /\ seen = <<>>

ResetTo(c) ==
    /\ shell' = c.shell
    /\ inherited' = c.inherited
    /\ zmode' = c.zmode
    /\ fstate' = c.fstate
    /\ ver' = [d \in Dirs |-> 0]
    /\ snap' = NoSnap
    /\ captures' = 0
    /\ seen' = <<>>

TraceInit == k = 1 /\ pos = 1 /\ InitWith(Observed[1])

Pending == k <= Len(Observed) /\ pos <= Len(Observed[k].events)
Event == Observed[k].events[pos]

TCapture == k <= Len(Observed) /\ Capture /\ UNCHANGED <<k, pos>>

TEdit ==
    /\ Pending
    /\ Event.kind = "edit"
    /\ Edit(ReadDir)
    /\ pos' = pos + 1
    /\ UNCHANGED k

TRun ==
    /\ Pending
    /\ Event.kind = "run"
    /\ Run
    /\ seen'[Len(seen')] = Event.saw
    /\ pos' = pos + 1
    /\ UNCHANGED k

Advance ==
    /\ k <= Len(Observed)
    /\ pos > Len(Observed[k].events)
    /\ k' = k + 1
    /\ pos' = 1
    /\ IF k + 1 <= Len(Observed) THEN ResetTo(Observed[k + 1]) ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][TCapture \/ TEdit \/ TRun \/ Advance]_traceVars

\* Sentinel: violated exactly when every case matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
