--------------------------- MODULE SkillWalkTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays runs of the real fx binary through            *)
(* SkillWalk's own Walk action.                                            *)
(*                                                                         *)
(* SkillWalkObserved is generated by tests/tla/drivers/skills/driver.ts.  *)
(* It defines Observed, a sequence of records [depth, home, gits, listed]: *)
(* one folder layout the driver built, and the chain folders whose skill   *)
(* fx advertised in its first request.                                     *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* walk from that layout has ended having scanned exactly `listed`. The    *)
(* run is ACCEPTED when TLC violates NotAllMatched, which is reachable     *)
(* only after every observation matched. A completed search means          *)
(* REJECTED.                                                               *)
(***************************************************************************)
EXTENDS SkillWalk, SkillWalkObserved, Sequences

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ InitWith(Observed[1])

Step ==
    /\ k <= Len(Observed)
    /\ Walk
    /\ UNCHANGED k

Advance ==
    /\ k <= Len(Observed)
    /\ done
    /\ scanned = Observed[k].listed
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed)
       THEN /\ depth' = Observed[k + 1].depth
            /\ home' = Observed[k + 1].home
            /\ gits' = Observed[k + 1].gits
            /\ dir' = Observed[k + 1].depth
            /\ scanned' = {}
            /\ done' = FALSE
       ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
