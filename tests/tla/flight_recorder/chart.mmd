%% Always-on mmap flight recorder lifecycle (FlightRecorder.tla, design-mmap).
%% design-mmap passes all invariants (R1-R8, EvictOnlySealed, OneSwitchPerSegment) across 28,265,893 distinct states.
stateDiagram-v2
    state "Session open, producers idle" as Open
    state "Switching full segment (CAS pending)" as Switching
    state "Slot offset reserved (zero hole)" as OffsetReserved
    state "Frame header written" as HeaderWritten
    state "Payload copied to page cache" as Copied
    state "Evicting oldest sealed segment (gap written)" as Evicting
    state "Process exited cleanly" as Exited
    state "Crashed (kill -9 or power loss)" as Down
    state "Session deleted" as Deleted

    [*] --> Open : start fx session
    Open --> Switching : segment full and next segment ready
    Switching --> Open : CAS wins (seal and open next) or loses (retry in new segment)
    Open --> OffsetReserved : producer reserves offset by atomic add
    OffsetReserved --> HeaderWritten : producer writes magic, length, and header CRC
    HeaderWritten --> Copied : producer copies event bytes
    Copied --> Open : producer writes commit word
    Open --> Open : segment full without next ready (drop counted), prealloc, msync, or chat turn
    Open --> Evicting : segments above cap (write durable gap record first)
    Evicting --> Open : delete oldest sealed segment (no reserved frame inside)
    Open --> Exited : fx exits cleanly (writes exit record)
    Open --> Down : kill -9 or power loss
    Switching --> Down : kill -9 or power loss before slot reserved
    OffsetReserved --> Down : kill -9 or power loss (leaves zero hole)
    HeaderWritten --> Down : kill -9 or power loss mid-write
    Copied --> Down : kill -9 or power loss mid-write
    Evicting --> Down : kill -9 or power loss (durable gap already written)
    Exited --> Down : power loss before msync
    Down --> Open : fx reopens (rescans past holes, cuts torn frames, records gaps and missing exits)
    Exited --> Open : fx reopens new instance
    Open --> Deleted : user deletes session
    Evicting --> Deleted : user deletes session
    Down --> Deleted : user deletes session
    Exited --> Deleted : user deletes session

%% Rule breaks in the other designs and mutants (shortest paths from check.sh):
%% - design-queue breaks NoSilentLoss (R1): Open -> emit to queue -> kill -9 -> reopen (5 states).
%% - current-ring breaks NoSilentLoss (R1): Open -> emit to ring -> kill -9 -> reopen (4 states).
%% - current-reset breaks NoSilentLoss (R1): Open -> emit to ring -> kill -9 -> reopen (4 states).
%% - mutant-no-length-header breaks TornOnlyInFlight (R3): Open -> ReserveOffset -> WriteHeader (no length) -> ReserveOffset/WriteHeader/Copy/Commit (other thread) -> kill -9 -> reopen.
%% - mutant-no-resync breaks NoSilentLoss (R1): Open -> ReserveOffset (t1) -> ReserveOffset (t2) -> kill -9 -> reopen stops at first hole (5 states).
%% - mutant-switch-without-cas breaks OneSwitchPerSegment: Open -> ReserveOffset -> Prealloc -> kill -9 -> reopen -> ReserveOffset (t1) -> ReserveOffset (t2) -> SwitchSegment (t2) -> SwitchSegment (t1) opens second successor (9 states).
%% - mutant-counter-in-memory breaks NoSilentLoss (R1): Open -> fill segment -> drop in memory -> kill -9 -> reopen.
%% - mutant-wait-for-prealloc breaks UiNeverWaitsOnDisk (R7): Open -> ReserveOffset -> kill -9 -> reopen -> UI waits on prealloc.
%% - mutant-no-exit-mark breaks InstanceEndKnown (R5): Open -> kill -9 -> reopen (3 states).
%% - mutant-evict-without-gap breaks NoSilentLoss (R1): fill segments past cap -> Evict deletes segment 1 without gap -> kill -9 -> reopen.
%% - mutant-delete-before-gap breaks NoSilentLoss (R1): fill segments past cap -> Evict deletes segment 1 before writing gap -> kill -9 -> reopen.
%% - mutant-evict-open breaks EvictOnlySealed (R3.7): open 3rd segment (after crash/reopen) -> Evict picks unsealed or reserved-in-flight segment -> deletes it.
%%
%% Events this chart leaves out:
%%   disk full (prevents background preallocation without blocking UI or chat),
%%   interleaved ReserveOffset/WriteHeader/Copy/Commit and concurrent segment switches across UI and worker threads,
%%   subsequent crashes and reopens across multiple instances.
