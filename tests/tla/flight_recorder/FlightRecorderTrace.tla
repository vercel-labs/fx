--------------------------- MODULE FlightRecorderTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays one run of the real flight-recorder-lab       *)
(* binary (`src/core/flight_recorder/lab.zig`) against `FlightRecorder`    *)
(* (Design = "mmap").                                                      *)
(*                                                                         *)
(* `FlightRecorderObserved` is generated by                                *)
(* `tests/tla/drivers/flight_recorder/trace.test.ts` and defines:          *)
(*   TMaxEvents, TSegCap, TMaxSegs, TMaxInstances, Observed                *)
(*                                                                         *)
(* `NotAllMatched` is a sentinel: TLC reports it violated (exit 12) only   *)
(* after every observation matched a valid behavior of `FlightRecorder`.   *)
(* If any observation violates the model or invariants, TLC ends with no   *)
(* violation (exit 0), rejecting the trace.                                *)
(***************************************************************************)
EXTENDS FlightRecorder, FlightRecorderObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

ASSUME Len(Observed) >= 1

SegCommittedCount(s) ==
    Len(SelectSeq(s.frames, LAMBDA f : f.committed))

MatchSegs(segList, o) ==
    /\ Len(segList) = Len(o.segFrames)
    /\ \A i \in 1..Len(segList) : SegCommittedCount(segList[i]) = o.segFrames[i]

MatchLiveNext(o) ==
    /\ MatchSegs(segs', o)
    /\ mappedDropped' = o.dropped
    /\ persistedGap' = o.gapEvents
    /\ Cardinality(emitted') = o.emittedTotal
    /\ (o.op # "stop" => nextSegReady' = o.nextReady)

MatchStart(o) ==
    /\ MatchSegs(segs, o)
    /\ mappedDropped = o.dropped
    /\ persistedGap = o.gapEvents
    /\ Cardinality(emitted) = o.emittedTotal
    /\ nextSegReady = o.nextReady

InvariantsHoldNext ==
    /\ TypeOK'
    /\ NoSilentLoss'
    /\ PowerLossBounded'
    /\ TornOnlyInFlight'
    /\ OrderKept'
    /\ InstanceEndKnown'
    /\ SessionIsolated'
    /\ UiNeverWaitsOnDisk'
    /\ DeleteRemovesAll'
    /\ EvictOnlySealed'
    /\ OneSwitchPerSegment'

AllowBgStep(o) ==
    \/ /\ o.nextReady
       /\ ~nextSegReady
       /\ ~diskFull
       /\ Prealloc
    \/ /\ persistedGap < o.gapEvents
       /\ evictState = "idle"
       /\ EvictWriteGap
    \/ /\ evictState = "gap_written"
       /\ EvictDeleteSeg
    \/ /\ Tick

TraceInit == Init /\ k = 0

Precursor(o) ==
    \/ /\ o.op = "start"
       /\ \/ (o.failPrealloc /\ ~diskFull /\ DiskFull)
          \/ (~o.failPrealloc /\ o.nextReady /\ ~nextSegReady /\ Prealloc)
    \/ /\ o.op \in {"emit", "fill_segment"}
       /\ \/ /\ Cardinality(emitted) < o.emittedTotal
             /\ ReserveOffset(o.thread)
             /\ tPhase'[o.thread] # "idle"
          \/ /\ tPhase[o.thread] = "switching"
             /\ SwitchSegment(o.thread)
          \/ /\ tPhase[o.thread] = "offset_reserved"
             /\ WriteHeader(o.thread)
          \/ /\ tPhase[o.thread] = "header_written"
             /\ Copy(o.thread)
          \/ /\ tPhase[o.thread] = "copied"
             /\ Cardinality(emitted) < o.emittedTotal
             /\ Commit(o.thread)
          \/ AllowBgStep(o)
    \/ /\ o.op = "tick"
       /\ \/ (o.nextReady /\ ~nextSegReady /\ ~diskFull /\ Prealloc)
          \/ (persistedGap < o.gapEvents /\ evictState = "idle" /\ EvictWriteGap)
          \/ (evictState = "gap_written" /\ EvictDeleteSeg)
    \/ /\ o.op = "crash"
       /\ o.isBurst
       /\ \/ /\ tSeq["ui"] < o.maxUi
             /\ Cardinality(emitted) < o.emittedMax
             /\ ReserveOffset("ui")
          \/ /\ tSeq["worker"] < o.maxWorker
             /\ Cardinality(emitted) < o.emittedMax
             /\ ReserveOffset("worker")
          \/ \E t \in Threads :
                \/ SwitchSegment(t)
                \/ WriteHeader(t)
                \/ Copy(t)
                \/ Commit(t)
          \/ /\ ~nextSegReady
             /\ ~diskFull
             /\ Prealloc
          \/ /\ evictState = "idle"
             /\ EvictWriteGap
          \/ /\ evictState = "gap_written"
             /\ EvictDeleteSeg
          \/ Tick

Step(o) ==
    /\ \/ /\ o.op = "start"
          /\ UNCHANGED vars
          /\ MatchStart(o)
       \/ /\ o.op \in {"emit", "fill_segment"}
          /\ \/ /\ tPhase[o.thread] = "copied"
                /\ Commit(o.thread)
             \/ /\ tPhase[o.thread] = "idle"
                /\ Cardinality(emitted) < o.emittedTotal
                /\ ReserveOffset(o.thread)
                /\ tPhase'[o.thread] = "idle"
          /\ MatchLiveNext(o)
       \/ /\ o.op = "tick"
          /\ (Tick \/ UNCHANGED vars)
          /\ evictState' = "idle"
          /\ MatchLiveNext(o)
       \/ /\ o.op = "fail_prealloc_on"
          /\ (IF ~diskFull THEN DiskFull ELSE UNCHANGED vars)
          /\ MatchLiveNext(o)
       \/ /\ o.op = "stop"
          /\ CleanExit
          /\ MatchLiveNext(o)
       \/ /\ o.op = "crash"
          /\ Cardinality(emitted) >= o.emittedMin
          /\ Cardinality(emitted) <= o.emittedMax
          /\ ProcessCrash
       \/ /\ o.op = "reopen"
          /\ Reopen
          /\ Cardinality(recoveredEvents') = o.frames
          /\ Cardinality(mappedDroppedSet) = o.dropped
          /\ Cardinality(persistedGapSet) = o.gapEvents
          /\ Cardinality(tornFound') <= o.torn + o.missing
          /\ o.torn + o.missing <= Cardinality(tornFound') + Cardinality(Threads)
          /\ Cardinality((emitted \ powerLost) \ recoveredEvents') <=
                o.gapEvents + o.dropped + o.torn + o.missing
    /\ InvariantsHoldNext

TraceNext ==
    /\ k < Len(Observed)
    /\ \E o \in {Observed[k + 1]} :
         \/ (Precursor(o) /\ InvariantsHoldNext /\ UNCHANGED k)
         \/ (Step(o) /\ k' = k + 1)

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched == k < Len(Observed)
=============================================================================
