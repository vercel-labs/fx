------------------------ MODULE FetchAdmissionTrace ------------------------
(***************************************************************************)
(* Trace validation: replays hops observed from the real code through      *)
(* FetchAdmission's own actions.                                           *)
(*                                                                         *)
(* FetchAdmissionObserved is generated by tests/tla/drivers/web/driver.ts. *)
(* It defines Observed, a sequence of records [answers, outcome, dialed]:  *)
(* the addresses one hop got, as FetchAdmission address records, whether   *)
(* fx admitted or refused the hop, and the addresses it handed to the      *)
(* connector.                                                              *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has finished a hop in exactly the observed way. The run is        *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS FetchAdmission, FetchAdmissionObserved

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ Init

TraceResolve ==
    /\ k <= Len(Observed)
    /\ Resolve(Observed[k].answers)
    /\ UNCHANGED k

TraceCheck == Check /\ UNCHANGED k

TraceDial ==
    /\ k <= Len(Observed)
    /\ \E a \in Observed[k].dialed : Dial(a)
    /\ UNCHANGED k

Matches(o) ==
    /\ phase = o.outcome
    /\ answers = o.answers
    /\ dialed = o.dialed

\* The next observation is a new fetch: its first hop.
Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ phase' = "resolve"
    /\ hops' = 1
    /\ answers' = {}
    /\ dialed' = {}

TraceSpec == TraceInit /\ [][TraceResolve \/ TraceCheck \/ TraceDial \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
