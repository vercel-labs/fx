------------------------- MODULE FailureStreakTrace -------------------------
(***************************************************************************)
(* Trace validation: replays turns observed from the real fx binary        *)
(* through FailureStreak's own Step action.                                *)
(*                                                                         *)
(* FailureStreakObserved is generated by                                   *)
(* ../drivers/shell_command/failure-streak.test.ts. It defines Observed, a *)
(* sequence of turns [steps |-> <<[fail |-> S, write |-> w], ...>>,        *)
(* ended |-> BOOLEAN], where steps are the model steps fx ran and ended    *)
(* says whether the guard's notice ended the turn.                         *)
(*                                                                         *)
(* The turns are replayed in order. A turn advances only when the model    *)
(* ran every observed step and agrees on whether the turn ended. The       *)
(* replay is accepted when TLC violates the sentinel NotAllMatched, which  *)
(* is reachable only after every turn matched.                             *)
(***************************************************************************)
EXTENDS FailureStreak, FailureStreakObserved, TLC

VARIABLE turn
traceVars == <<streak, hist, ended, turn>>

Active == turn <= Len(Observed)
T == Observed[turn]

ReplayStep ==
  /\ Active
  /\ Len(hist) < Len(T.steps)
  /\ Step(T.steps[Len(hist) + 1].fail, T.steps[Len(hist) + 1].write)
  /\ UNCHANGED turn

NextTurn ==
  /\ Active
  /\ Len(hist) = Len(T.steps)
  /\ ended = T.ended
  /\ PrintT(<<"FXT_MATCHED", turn>>)
  /\ turn' = turn + 1
  /\ streak' = [c \in Cmds |-> 0]
  /\ hist' = << >>
  /\ ended' = FALSE

TraceInit == Init /\ turn = 1

TraceNext == ReplayStep \/ NextTurn

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

(* Sentinel: violated exactly when the whole observation matched.           *)
NotAllMatched == turn <= Len(Observed)
=============================================================================
