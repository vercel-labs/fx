--------------------------- MODULE SavedTurnTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays one turn observed from the real fx binary     *)
(* through SavedTurn's own actions.                                        *)
(*                                                                         *)
(* SavedTurnObserved is generated by                                       *)
(* tests/tla/drivers/saved_turn/driver.ts. It defines Observed, a record   *)
(* [sent, next]: sent holds, for each request the turn made, the messages  *)
(* that followed the user's own, mapped to SavedTurn's atoms; next holds   *)
(* the messages the next turn's first request carried for this turn, with  *)
(* the turn's final reply left out.                                        *)
(*                                                                         *)
(* The model must be able to send exactly the observed requests, in order, *)
(* and, when the turn ends, its Restore of the turn must be the observed   *)
(* next. The run is ACCEPTED when TLC violates NotAllMatched, which is     *)
(* reachable only then. A completed search means REJECTED: the model of    *)
(* the design cannot produce what fx did, as the model of fx before the    *)
(* change (Bug = "append_notes") cannot produce what the changed fx does.  *)
(***************************************************************************)
EXTENDS SavedTurn, SavedTurnObserved

\* Each request must carry exactly the messages observed.
TraceTop == Top /\ requests < Len(Observed.sent) /\ sent' = Observed.sent[requests + 1]

TraceNext ==
    \/ ContextChange \/ TraceTop \/ ToolStep \/ EmptyReply \/ HookReply \/ SteerReply
    \/ FinalReply \/ Cancel \/ ReviewStep \/ GoOn \/ FinalizingSteer \/ StepLimit \/ Ended

TraceSpec == Init /\ [][TraceNext]_vars

TraceBounded == requests <= Len(Observed.sent)

Matches ==
    /\ phase = "done"
    /\ requests = Len(Observed.sent)
    /\ Restore(live) = Observed.next

\* Sentinel: violated exactly when the observed turn matched.
NotAllMatched == ~Matches
=============================================================================
