-------------------------- MODULE StreamTailTrace --------------------------
\* Trace validation for the real AssistantPacer (src/ui/assistant/pacer.zig)
\* against StreamTail.tla's pacing, age-cap, and finish rules.
\*
\* Observed is generated by tests/tla/drivers/assistant_stream/paced-trace.test.ts
\* from FX_TRACE_LOG (FX_TRACE_SCOPES=pacer). Each entry is one of:
\*   [type |-> "slot_queued", backlog |-> Nat]
\*   [type |-> "reveal", k |-> Nat, backlog |-> Nat, rate |-> Nat, window |-> Nat, finish |-> Nat, finishing |-> Nat]
\*   [type |-> "finish_deferred", backlog |-> Nat]
\*   [type |-> "finish_fired", pending |-> Nat, slots |-> Nat]
\*
\* TLC accepts the run iff NotAllMatched is violated without first violating
\* RevealInBounds, TraceBoundedStall, or TraceNoLossAtFinish.
EXTENDS StreamTail, StreamTailTraceObserved

VARIABLES
    idx,
    qAges,
    traceStalled,
    inReveal,
    traceRevealK,
    traceRevealBacklog,
    traceRevealExpired,
    traceFinished,
    finishPending,
    finishSlots

traceVars == << vars, idx, qAges, traceStalled, inReveal, traceRevealK,
                traceRevealBacklog, traceRevealExpired, traceFinished,
                finishPending, finishSlots >>

RECURSIVE ExpiredAgeCount(_, _)
ExpiredAgeCount(ages, w) ==
    IF ages = <<>> THEN 0
    ELSE IF Head(ages) >= w - 1
    THEN 1 + ExpiredAgeCount(Tail(ages), w)
    ELSE 0

TraceInit ==
    /\ fullSrc = <<"w">>
    /\ src = <<>>
    /\ committed = <<>>
    /\ tail = <<>>
    /\ history = 0
    /\ spec = FALSE
    /\ Q = <<>>
    /\ shown = [rows |-> <<>>, len |-> 0]
    /\ stalled = 0
    /\ gate = "none"
    /\ finished = FALSE
    /\ cancelled = FALSE
    /\ stagedIds = {}
    /\ lastRevealCount = 0
    /\ lastRevealQueue = 0
    /\ lastRevealExpired = 0
    /\ lastBoundaryQueue = 0
    /\ lastBoundaryLen = 0
    /\ idx = 1
    /\ qAges = <<>>
    /\ traceStalled = 0
    /\ inReveal = FALSE
    /\ traceRevealK = 0
    /\ traceRevealBacklog = 0
    /\ traceRevealExpired = 0
    /\ traceFinished = FALSE
    /\ finishPending = 0
    /\ finishSlots = 0

Step ==
    /\ idx <= Len(Observed)
    /\ LET ev == Observed[idx]
       IN IF ev.type = "slot_queued"
          THEN LET ages1 == IF ev.backlog = 0 THEN <<>>
                            ELSE IF Len(qAges) < ev.backlog
                            THEN qAges \o [i \in 1..(ev.backlog - Len(qAges)) |-> 0]
                            ELSE [i \in 1..ev.backlog |-> 0]
               IN /\ qAges' = ages1
                  /\ traceStalled' = IF ages1 = <<>> THEN 0 ELSE ages1[1]
                  /\ inReveal' = FALSE
                  /\ traceRevealK' = 0
                  /\ traceRevealBacklog' = 0
                  /\ traceRevealExpired' = 0
                  /\ UNCHANGED << traceFinished, finishPending, finishSlots >>
          ELSE IF ev.type = "reveal"
          THEN LET b == ev.backlog
                   k == ev.k
                   ages0 == IF Len(qAges) < b
                            THEN qAges \o [i \in 1..(b - Len(qAges)) |-> 0]
                            ELSE SubSeq(qAges, Len(qAges) - b + 1, Len(qAges))
                   expired == ExpiredAgeCount(ages0, W)
                   pop == IF k <= Len(ages0) THEN k ELSE Len(ages0)
                   rem == [i \in 1..(Len(ages0) - pop) |-> ages0[pop + i] + 1]
               IN /\ qAges' = rem
                  /\ traceStalled' = IF rem = <<>> THEN 0 ELSE rem[1]
                  /\ inReveal' = TRUE
                  /\ traceRevealK' = k
                  /\ traceRevealBacklog' = b
                  /\ traceRevealExpired' = expired
                  /\ UNCHANGED << traceFinished, finishPending, finishSlots >>
          ELSE IF ev.type = "finish_deferred"
          THEN /\ inReveal' = FALSE
               /\ traceRevealK' = 0
               /\ traceRevealBacklog' = 0
               /\ traceRevealExpired' = 0
               /\ UNCHANGED << qAges, traceStalled, traceFinished, finishPending, finishSlots >>
          ELSE \* "finish_fired"
               /\ qAges' = <<>>
               /\ traceStalled' = 0
               /\ inReveal' = FALSE
               /\ traceRevealK' = 0
               /\ traceRevealBacklog' = 0
               /\ traceRevealExpired' = 0
               /\ traceFinished' = TRUE
               /\ finishPending' = ev.pending
               /\ finishSlots' = ev.slots
    /\ idx' = idx + 1
    /\ UNCHANGED vars

TraceDone ==
    /\ idx > Len(Observed)
    /\ UNCHANGED traceVars

TraceNext == Step \/ TraceDone

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

\* Every reveal satisfies max(ceil(backlog / W), expired) <= k <= backlog.
RevealInBounds ==
    inReveal =>
        /\ traceRevealBacklog >= 1
        /\ CeilDiv(traceRevealBacklog, W) <= traceRevealK
        /\ traceRevealExpired <= traceRevealK
        /\ traceRevealK <= traceRevealBacklog

\* BoundedStall: oldest queued step waits at most W reveal steps.
TraceBoundedStall ==
    qAges /= <<>> => traceStalled <= W

\* NoLossAtFinish: finish_fired only happens when pending = 0 and slots = 0.
TraceNoLossAtFinish ==
    traceFinished => (finishPending = 0 /\ finishSlots = 0)

\* Sentinel: violated once every observed event has been matched cleanly.
NotAllMatched == idx <= Len(Observed)

=============================================================================
