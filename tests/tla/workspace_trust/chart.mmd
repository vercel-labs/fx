%% One launch of fx in Design "a" (tests/tla/workspace_trust/WorkspaceTrust.tla).
%% Checked against design-a.cfg's TLC graph (`-dump dot,actionlabels`).
%% Design "a" breaks no rule in design-a.cfg: check.sh finds all six invariants true.
stateDiagram-v2
    state "Starting fx" as Start
    state "Folder access screen" as Asking
    state "Saved for this folder, working in the folder" as SavedWorking
    state "Working in the folder, not saved notice shown" as NoticeWorking
    state "Working in the folder" as Working
    state "fx has quit" as Quit

    state "Working without consent" as BadSkip
    state "Folder access screen shown for fx ask" as BadHeadless
    state "Working in a spoofed folder with borrowed trust" as BadSpoof
    state "fx has quit, but folder saved as trusted" as BadSaveNo
    state "Working, home folder saved as trusted" as BadSaveHome
    state "Working, unsaved with no notice" as BadLostWrite

    [*] --> Start
    Start --> Asking : you start interactive fx in an untrusted, spoofed, or home folder
    Start --> Working : you start interactive fx in a trusted folder or registered worktree, or you run fx ask
    Asking --> SavedWorking : you press Enter on Yes in a project folder
    Asking --> NoticeWorking : you press Enter on Yes in a project folder and the save fails
    Asking --> Working : you press Enter on Yes in your home folder
    Asking --> Quit : you press 2, Esc or Ctrl+C

    Start --> BadSkip : mutant skip_check only, interactive fx skips the screen
    Start --> BadHeadless : mutant headless_prompt only, fx ask opens the screen
    Start --> BadSpoof : mutant trust_spoof only, spoofed folder borrows repo trust
    Asking --> BadSaveNo : mutant save_on_no only, declining still saves trust
    Asking --> BadSaveHome : mutant save_home only, Yes saves the home folder
    Asking --> BadLostWrite : mutant lost_write only, save fails with no notice

    note right of BadSkip
        Rule broken: ConsentBeforeSession.
        Shortest path, 1 step: open interactive fx in an untrusted or home folder.
    end note
    note right of BadHeadless
        Rule broken: HeadlessNeverWaits.
        Shortest path, 1 step: run fx ask in any folder.
    end note
    note right of BadSpoof
        Rule broken: NoBorrowedTrust.
        Shortest path, 1 step: open interactive fx in a spoofed folder while the real repo is trusted.
    end note
    note right of BadSaveNo
        Rule broken: NoNeverSaves.
        Shortest path, 2 steps: open interactive fx in an untrusted folder, then press 2, Esc or Ctrl+C.
    end note
    note right of BadSaveHome
        Rule broken: HomeNeverSaved.
        Shortest path, 2 steps: open interactive fx in your home folder, then press Enter on Yes.
    end note
    note right of BadLostWrite
        Rule broken: SavedOrSaid.
        Shortest path, 2 steps: open interactive fx in an untrusted project folder, then press Enter on Yes when the save fails.
    end note

