------------------------ MODULE WorkspaceTrustTrace ------------------------
(***************************************************************************)
(* Trace validation: replays behavior observed from the real fx binary     *)
(* through WorkspaceTrust's own actions for Design "a".                    *)
(*                                                                         *)
(* WorkspaceTrustObserved is generated by                                  *)
(* tests/tla/drivers/workspace_trust/bridge.ts. It defines Observed, a     *)
(* sequence of records                                                     *)
(*   [surface, folder, repoTrusted, answer, exited, savedAfter]            *)
(* where surface is "tui" or "headless", folder is one of Folders,         *)
(* repoTrusted is whether store["repo"] starts as "trusted", answer is     *)
(* "yes", "no", or "none" (no screen was shown), exited is TRUE when fx    *)
(* ended at the screen, and savedAfter is whether store[TrueKey(folder)]   *)
(* is "trusted" at the end.                                                *)
(*                                                                         *)
(* Each observation starts from a fresh state where launch 1 has the       *)
(* observation's surface and folder, launch 2 never moves, store["repo"]   *)
(* matches repoTrusted, every other key is "unknown", initStore = store,   *)
(* and yesKeys = {}. Only launch 1 acts, only through Decide, AnswerYes,   *)
(* and AnswerNo. The run is ACCEPTED when TLC violates NotAllMatched,      *)
(* reachable only after every observation matched in order. A completed    *)
(* search means REJECTED.                                                  *)
(***************************************************************************)
EXTENDS WorkspaceTrust, WorkspaceTrustObserved, Sequences, Naturals

VARIABLE k, asked
traceVars == <<vars, k, asked>>

FreshStore(repoTrusted) ==
  [key \in Keys |-> IF key = "repo" /\ repoTrusted THEN "trusted" ELSE "unknown"]

FreshLn(surface, folder) ==
  [l \in Launches |->
    [surface |-> IF l = 1 THEN surface ELSE "tui",
     folder  |-> IF l = 1 THEN folder ELSE "repo",
     phase   |-> "start",
     yes     |-> FALSE,
     trust   |-> FALSE,
     repo    |-> FALSE,
     notice  |-> FALSE]]

ValidObservation(o) ==
  /\ o.surface \in Surfaces
  /\ o.folder \in Folders
  /\ o.repoTrusted \in BOOLEAN
  /\ o.answer \in {"yes", "no", "none"}
  /\ o.exited \in BOOLEAN
  /\ o.savedAfter \in BOOLEAN

Matches(o) ==
  /\ ValidObservation(o)
  /\ CASE o.answer = "yes" ->
            /\ ln[1].phase = "running"
            /\ ln[1].yes
            /\ ~o.exited
       [] o.answer = "no" ->
            /\ ln[1].phase = "exited"
            /\ o.exited
       [] o.answer = "none" ->
            /\ ln[1].phase = "running"
            /\ ~ln[1].yes
            /\ ~asked
            /\ ~o.exited
       [] OTHER -> FALSE
  /\ (store[TrueKey(o.folder)] = "trusted") <=> o.savedAfter

TraceInit ==
  /\ Len(Observed) > 0
  /\ ValidObservation(Observed[1])
  /\ k = 1
  /\ asked = FALSE
  /\ store = FreshStore(Observed[1].repoTrusted)
  /\ initStore = FreshStore(Observed[1].repoTrusted)
  /\ yesKeys = {}
  /\ ln = FreshLn(Observed[1].surface, Observed[1].folder)

Step ==
  /\ k <= Len(Observed)
  /\ (Decide(1) \/ AnswerYes(1) \/ AnswerNo(1))
  /\ asked' = (asked \/ ln'[1].phase = "asking")
  /\ UNCHANGED k

Advance ==
  /\ k <= Len(Observed)
  /\ Matches(Observed[k])
  /\ k' = k + 1
  /\ IF k + 1 <= Len(Observed)
       THEN LET nxt == Observed[k + 1] IN
            /\ ValidObservation(nxt)
            /\ store' = FreshStore(nxt.repoTrusted)
            /\ initStore' = FreshStore(nxt.repoTrusted)
            /\ yesKeys' = {}
            /\ asked' = FALSE
            /\ ln' = FreshLn(nxt.surface, nxt.folder)
       ELSE UNCHANGED <<vars, asked>>

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

(* Sentinel: violated exactly when every observation matched.               *)
NotAllMatched == k <= Len(Observed)
=============================================================================
