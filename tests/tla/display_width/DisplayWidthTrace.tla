------------------------- MODULE DisplayWidthTrace -------------------------
(***************************************************************************)
(* Trace validation: replays composer walks observed from the built fx    *)
(* binary through DisplayWidth's own actions.                              *)
(*                                                                         *)
(* DisplayWidthObserved is generated by                                    *)
(* tests/tla/drivers/display_width/driver.ts. It defines Observed, a       *)
(* sequence of walks. Each walk is a sequence of records                  *)
(* [key, cls, col, row]: the key sent (clear, type, left, right,           *)
(* backspace, home, end), the class of the code point typed ("none" for    *)
(* the other keys), the cursor column tmux reported afterwards, counted    *)
(* from the first cell after the composer's prefix across its rows, and    *)
(* the classes of the code points tmux shows on the composer's rows after  *)
(* the prefix, in order, with "gap" for a blank cell. Every walk starts    *)
(* with clear, which is End then Ctrl+U. In a window with no content cells *)
(* fx clamps the cursor to the window's last column, so there is no        *)
(* column to compare and the record holds col -1.                          *)
(*                                                                         *)
(* A step matches only when the model's action puts the cursor at the      *)
(* observed column (at any column when none is observed) and the rows show *)
(* exactly what the model says the terminal shows (Shown): no gap, nothing *)
(* left over from an earlier repaint, no mark lost at the right margin,    *)
(* and no mark on a row with no content cells. The run is ACCEPTED when    *)
(* TLC violates NotAllMatched, which is reachable only after every step of *)
(* every walk matched. A completed search means REJECTED.                  *)
(***************************************************************************)
EXTENDS DisplayWidth, DisplayWidthObserved

VARIABLES w, k
traceVars == <<vars, w, k>>

Act(o) ==
    CASE o.key = "clear" -> Clear
      [] o.key = "type" -> TypeStep(o.cls)
      [] o.key = "left" -> Left
      [] o.key = "right" -> Right
      [] o.key = "backspace" -> Backspace
      [] o.key = "home" -> Home
      [] o.key = "end" -> End

TraceInit == Init /\ w = 1 /\ k = 0

Step ==
    /\ w <= Len(Observed)
    /\ k < Len(Observed[w])
    /\ Act(Observed[w][k + 1])
    /\ (Observed[w][k + 1].col < 0 \/ col' = Observed[w][k + 1].col)
    /\ Shown(text') = Observed[w][k + 1].row
    /\ k' = k + 1
    /\ UNCHANGED w

NextWalk ==
    /\ w <= Len(Observed)
    /\ k = Len(Observed[w])
    /\ w' = w + 1
    /\ k' = 0
    /\ text' = <<>>
    /\ cursor' = 0
    /\ col' = 0

TraceSpec == TraceInit /\ [][Step \/ NextWalk]_traceVars

\* Sentinel: violated exactly when every walk matched.
NotAllMatched == w <= Len(Observed)
=============================================================================
