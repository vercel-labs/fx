------------------------- MODULE DisplayWidthTrace -------------------------
(***************************************************************************)
(* Trace validation: replays composer walks observed from the built fx    *)
(* binary through DisplayWidth's own actions.                              *)
(*                                                                         *)
(* DisplayWidthObserved is generated by                                    *)
(* tests/tla/drivers/display_width/driver.ts. It defines Observed, a       *)
(* sequence of walks. Each walk is a sequence of records                  *)
(* [key, cls, n, col, row]: the key sent (clear, type, type_run, left,     *)
(* right, backspace, home, end), the class of the code point typed ("none" *)
(* for the other keys), how many of them one type_run sends together (1    *)
(* for the other keys), the cursor column tmux reported afterwards,        *)
(* counted from the first cell after the composer's prefix across its      *)
(* rows, and the classes of the code points tmux shows on the composer's   *)
(* rows after the prefix, in order, with "gap" for a blank cell and        *)
(* "circle" for U+25CC. Every walk starts with clear, which is End then    *)
(* Ctrl+U. In a window with no content cells fx clamps the cursor to the   *)
(* window's last column, so there is no column to compare and the record   *)
(* holds col -1.                                                           *)
(*                                                                         *)
(* Cap is fx's own limit, 64 bytes of text on one cell. tmux, which the    *)
(* driver reads, keeps fewer marks on a cell than fx draws and not always  *)
(* the same number (nine and ten were seen), so each run of marks on a     *)
(* cell is compared up to ViewMarks of them (View) and the exact count is  *)
(* left to tests/e2e/tui-input-navigation.test.ts, which reads fx's own    *)
(* screen through fx replay, and to tests/tla/terminal_cell/.              *)
(*                                                                         *)
(* A step matches only when the model's action puts the cursor at the      *)
(* observed column (at any column when none is observed), the step does   *)
(* not fail (Shown fail, which ends fx), and the rows show exactly what    *)
(* the model says the terminal shows (Shown): no gap, nothing left over    *)
(* from an earlier repaint, no mark lost at the right margin, no mark on   *)
(* a row with no content cells, a circle under a mark with no base, and no *)
(* more marks on a cell than it holds. The run is ACCEPTED when            *)
(* TLC violates NotAllMatched, which is reachable only after every step of *)
(* every walk matched. A completed search means REJECTED.                  *)
(***************************************************************************)
EXTENDS DisplayWidth, DisplayWidthObserved

CONSTANT ViewMarks

\* `s` with every run of marks cut to its first ViewMarks. A circle or any
\* other unit ends a run.
RECURSIVE ViewFrom(_, _)
ViewFrom(s, run) ==
    IF s = <<>> THEN <<>>
    ELSE IF IsMark(Head(s))
    THEN (IF run < ViewMarks THEN <<Head(s)>> ELSE <<>>) \o ViewFrom(Tail(s), run + 1)
    ELSE <<Head(s)>> \o ViewFrom(Tail(s), 0)

View(s) == ViewFrom(s, 0)

VARIABLES w, k
traceVars == <<vars, w, k>>

Act(o) ==
    CASE o.key = "clear" -> Clear
      [] o.key = "type" -> TypeStep(o.cls)
      [] o.key = "type_run" -> TypeRunStep(o.cls, o.n)
      [] o.key = "left" -> Left
      [] o.key = "right" -> Right
      [] o.key = "backspace" -> Backspace
      [] o.key = "home" -> Home
      [] o.key = "end" -> End

TraceInit == Init /\ w = 1 /\ k = 0

Step ==
    /\ w <= Len(Observed)
    /\ k < Len(Observed[w])
    /\ Act(Observed[w][k + 1])
    /\ (Observed[w][k + 1].col < 0 \/ col' = Observed[w][k + 1].col)
    /\ ~Shown(text').fail
    /\ View(Shown(text').seq) = View(Observed[w][k + 1].row)
    /\ k' = k + 1
    /\ UNCHANGED w

NextWalk ==
    /\ w <= Len(Observed)
    /\ k = Len(Observed[w])
    /\ w' = w + 1
    /\ k' = 0
    /\ text' = <<>>
    /\ cursor' = 0
    /\ col' = 0

TraceSpec == TraceInit /\ [][Step \/ NextWalk]_traceVars

\* Sentinel: violated exactly when every walk matched.
NotAllMatched == w <= Len(Observed)
=============================================================================
