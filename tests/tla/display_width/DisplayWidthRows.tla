------------------------- MODULE DisplayWidthRows -------------------------
(***************************************************************************)
(* Trace validation: replays rows of text that the built fx binary draws    *)
(* after a fixed prefix cell through DisplayWidth's own Shown.             *)
(*                                                                         *)
(* DisplayWidthRowsObserved is generated by                                *)
(* tests/tla/drivers/display_width/prefixed.ts. It defines Observed, a     *)
(* sequence of records [surface, id, text, row]: the surface that drew the *)
(* text (a question's option label, the answer row a resolved question     *)
(* leaves in the transcript, or the steering banner of a queued message),  *)
(* the classes of the code points of the text, and the classes of the code *)
(* points tmux shows on the rows of that text after the prefix, in order,  *)
(* with "circle" for U+25CC and "gap" for a blank cell. A text that wraps  *)
(* shows all of its rows, one after the other. Cols is the cells a row has *)
(* after its prefix, the same for every record of one run.                 *)
(*                                                                         *)
(* Each surface draws text after a prefix cell that is no base for a mark, *)
(* so each applies the rule BareCol0 models, as the composer does: a mark  *)
(* that starts its row, with nothing but zero-width characters before it,  *)
(* takes one cell on a dotted circle. A record matches when the model's    *)
(* Shown of its text is exactly the observed row and the step does not     *)
(* fail. The run is ACCEPTED when TLC violates NotAllMatched, which is     *)
(* reachable only after every record matched. A completed search means     *)
(* REJECTED.                                                               *)
(***************************************************************************)
EXTENDS DisplayWidth, DisplayWidthRowsObserved

VARIABLE n
rowVars == <<vars, n>>

RowsInit == Init /\ n = 0

RowsStep ==
    /\ n < Len(Observed)
    /\ ~Shown(Observed[n + 1].text).fail
    /\ Shown(Observed[n + 1].text).seq = Observed[n + 1].row
    /\ n' = n + 1
    /\ UNCHANGED vars

RowsSpec == RowsInit /\ [][RowsStep]_rowVars

\* Sentinel: violated exactly when every record matched.
NotAllMatched == n < Len(Observed)
=============================================================================
