---------------------- MODULE SubscriptionRefreshTrace ----------------------
(***************************************************************************)
(* Trace validation: replays runs of the real fx binary through            *)
(* SubscriptionRefresh's own actions.                                      *)
(*                                                                         *)
(* SubscriptionRefreshObserved is generated by                             *)
(* tests/tla/drivers/auth/driver.ts. It defines Observed, a sequence of    *)
(* records [cmd, provider, stored, margin, reply, outcome, file]: the      *)
(* command, the login's provider, the saved expiry mapped onto the model's *)
(* range, the saved skew on the same range (Skew for a subscription login, *)
(* skew_ms for an MCP login), the refresh reply the fake issuer sent       *)
(* (NoReply when none), how fx ended, and what was left of the saved       *)
(* login.                                                                  *)
(*                                                                         *)
(* Runs are replayed in order. The index k advances only when the model    *)
(* has finished a run in exactly the observed way. The trace is ACCEPTED   *)
(* when TLC violates NotAllMatched, which is reachable only after every    *)
(* run matched. A completed search means REJECTED.                         *)
(***************************************************************************)
EXTENDS SubscriptionRefresh, SubscriptionRefreshObserved, Sequences

VARIABLE k
traceVars == <<vars, k>>

TraceInit ==
    /\ k = 1
    /\ InitWith(Observed[1].cmd, Observed[1].provider, Observed[1].stored, Observed[1].margin)

Step ==
    /\ k <= Len(Observed)
    /\ NextWith({Observed[k].reply} \cap Replies)
    /\ UNCHANGED k

Matches(o) ==
    /\ phase = "done"
    /\ reply = o.reply
    /\ outcome = o.outcome
    /\ file = o.file

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed)
       THEN Begin(Observed[k + 1].cmd, Observed[k + 1].provider, Observed[k + 1].stored, Observed[k + 1].margin)
       ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
