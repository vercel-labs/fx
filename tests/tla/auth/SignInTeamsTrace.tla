-------------------------- MODULE SignInTeamsTrace --------------------------
(***************************************************************************)
(* Trace validation: replays sign-ins observed from the real fx binary     *)
(* through SignInTeams' own actions.                                       *)
(*                                                                         *)
(* SignInTeamsObserved is generated by tests/tla/drivers/auth/driver.ts.   *)
(* It defines Observed, a sequence of records [surface, prior, resp,       *)
(* outcome, saved, offered, rawOut, alive]: where fx signed in, what the   *)
(* session store held before, what /v2/teams answered, what the person was *)
(* told, what the store held after, how many teams were offered (-1 when   *)
(* the driver cannot count them), whether fx wrote a control character,    *)
(* and whether fx was still running.                                       *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has finished a sign-in in exactly the observed way. The run is    *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS SignInTeams, SignInTeamsObserved

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ InitWith(Observed[1].surface, Observed[1].prior)

Step ==
    /\ k <= Len(Observed)
    /\ \/ Token
       \/ Answer(Observed[k].resp)
       \/ Pick
    /\ UNCHANGED k

Matches(o) ==
    /\ phase = "done"
    /\ resp = o.resp
    /\ outcome = o.outcome
    /\ saved = o.saved
    /\ (o.offered < 0 \/ offered = o.offered)
    /\ rawOut = o.rawOut
    /\ alive = o.alive

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed)
         THEN Reset(Observed[k + 1].surface, Observed[k + 1].prior)
         ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
