------------------------- MODULE StartupFixtureTrace -------------------------
(***************************************************************************)
(* Trace validation: replays runs of the real benchmarks/startup.sh        *)
(* through StartupFixture's own script actions, without Intrude.           *)
(*                                                                         *)
(* StartupFixtureObserved is generated by                                  *)
(* tests/tla/drivers/benchmarks/driver.ts. It defines Observed, a          *)
(* sequence of records, one per run:                                       *)
(*   foreign  the names of the folders planted in TMPDIR before the run    *)
(*   usable   whether TMPDIR took new folders                              *)
(*   ended    "finished" (exit 0), "failed" (another exit code), "signal"  *)
(*            (SIGTERM), or "killed" (SIGKILL)                             *)
(*   during   <<the names in TMPDIR when hyperfine first ran>>, or <<>>    *)
(*            when the run never reached hyperfine                         *)
(*   root     the name of the folder that held HOME at that moment         *)
(*   after    the names in TMPDIR after the run                            *)
(*   wiped    the planted folders whose marker file was gone               *)
(*                                                                         *)
(* Runs are replayed in order. The index k advances only when the model    *)
(* has ended a run in exactly the observed way. The runs are ACCEPTED when *)
(* TLC violates NotAllMatched, which is reachable only after every run     *)
(* matched. A completed search means REJECTED.                             *)
(***************************************************************************)
EXTENDS StartupFixture, StartupFixtureObserved

VARIABLE k
traceVars == <<vars, k>>

Start(o) ==
    /\ pc = 1
    /\ owner = [n \in Names |-> IF n \in o.foreign THEN "other" ELSE "none"]
    /\ wiped = {}
    /\ root = ""
    /\ armed = FALSE
    /\ usable = o.usable
    /\ ended = "none"
    /\ seen = <<>>

Restart(o) ==
    /\ pc' = 1
    /\ owner' = [n \in Names |-> IF n \in o.foreign THEN "other" ELSE "none"]
    /\ wiped' = {}
    /\ root' = ""
    /\ armed' = FALSE
    /\ usable' = o.usable
    /\ ended' = "none"
    /\ seen' = <<>>

TraceInit == k = 1 /\ Start(Observed[1])

Matches(o) ==
    /\ ended = o.ended
    /\ seen = o.during
    /\ o.during # <<>> => root = o.root
    /\ Exists = o.after
    /\ wiped = o.wiped

RunStep ==
    /\ k <= Len(Observed)
    /\ ScriptNext
    /\ UNCHANGED k

NextRun ==
    /\ k <= Len(Observed)
    /\ ~Running
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed) THEN Restart(Observed[k + 1]) ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][RunStep \/ NextRun]_traceVars

\* Sentinel: violated exactly when every run matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
