--------------------------- MODULE TerminalCellTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays runs observed from the real fx binary through  *)
(* TerminalCell's own actions.                                              *)
(*                                                                          *)
(* TerminalCellObserved is generated by                                     *)
(* tests/tla/drivers/terminal_cell/driver.ts. It defines Observed, a        *)
(* sequence of records [base, units, alive, aused, acol, bused, bcol]: the  *)
(* bytes of the base character, the stream of zero-width units as their     *)
(* sizes, whether fx replayed both tapes, and, when it did, the bytes of    *)
(* suffix and the column of the next character that grid A (one unit per    *)
(* read) and grid B (two units per read) ended with.                        *)
(*                                                                          *)
(* Observations are replayed in order. The index k advances only when the   *)
(* model has finished a stream in exactly the observed way. The run is      *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after  *)
(* every observation matched. A completed search means REJECTED.            *)
(***************************************************************************)
EXTENDS TerminalCell, TerminalCellObserved

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ InitWith(Observed[1].base, Observed[1].units)

Step == k <= Len(Observed) /\ Next /\ UNCHANGED k

Matches(o) ==
    /\ alive = o.alive
    /\ alive =>
        /\ Done
        /\ aused = o.aused /\ bused = o.bused
        /\ acol = o.acol /\ bcol = o.bcol

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed)
          THEN ResetTo(Observed[k + 1].base, Observed[k + 1].units)
          ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
