--------------------------- MODULE QuietWaitTrace ---------------------------
(***************************************************************************)
(* Trace validation: checks waits observed on the real fx binary against   *)
(* QuietWait's own actions.                                                *)
(*                                                                         *)
(* QuietWaitObserved is generated by                                       *)
(* tests/tla/drivers/managed_execution/binary.ts. It defines Observed, a   *)
(* sequence of records, one per shell interact call in order:              *)
(*   ceils     the ceilings, in ticks, the call's yield_time_ms may round  *)
(*             to                                                          *)
(*   ends      why the wait may have ended, from its state and how long it *)
(*             took                                                        *)
(*   running   the result said running                                     *)
(*   notice    the result carried quiet_notice                             *)
(*   quietDue  the values quiet_ms >= the limit may take (both for a       *)
(*             result without quiet_ms)                                    *)
(*   output    the result carried output                                   *)
(*                                                                         *)
(* The binary's clock and the model's ticks are not aligned, so output,    *)
(* the exit, and ticks interleave freely; each wait begins with one of its *)
(* ceilings and must end with a result that matches its observation. The  *)
(* run is ACCEPTED when TLC violates NotAllMatched, which is reachable     *)
(* only after every observation matched. A completed search means          *)
(* REJECTED.                                                               *)
(***************************************************************************)
EXTENDS QuietWait, QuietWaitObserved, Sequences

VARIABLES
    k,         \* the next observation
    outSince   \* output since the last result, which the next result carries

traceVars == <<vars, k, outSince>>

TraceInit == Init /\ k = 1 /\ outSince = FALSE

\* The result a wait ended with matches its observation. outSince is the
\* output the result carries: since the last result, during the wait or
\* before it.
Matches(r, o) ==
    /\ r.end \in o.ends
    /\ r.running = o.running
    /\ r.notice = o.notice
    /\ r.quietDue \in o.quietDue
    /\ outSince = o.output

TraceStep ==
    \/ /\ Output
       /\ outSince' = TRUE
       /\ UNCHANGED k
    \/ /\ Finish \/ Tick
       /\ UNCHANGED <<k, outSince>>
    \/ /\ k <= Len(Observed)
       /\ \E c \in Observed[k].ceils : c <= MaxCeil /\ Begin(c)
       /\ UNCHANGED <<k, outSince>>
    \/ /\ Poll
       /\ IF waiting'
          THEN UNCHANGED <<k, outSince>>
          ELSE /\ k <= Len(Observed)
               /\ Matches(result', Observed[k])
               /\ k' = k + 1
               /\ outSince' = FALSE

TraceSpec == TraceInit /\ [][TraceStep]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
