------------------------- MODULE GrokIdentityTrace -------------------------
(***************************************************************************)
(* Trace validation: replays runs of the real fx binary through            *)
(* GrokIdentity's own actions.                                             *)
(*                                                                         *)
(* GrokIdentityObserved is generated by                                    *)
(* tests/tla/drivers/grok_oauth/driver.ts. It defines Observed, a sequence *)
(* of records [cmd, kind, login, signedAs, asked, form, ask, saved,        *)
(* afterKill]: the command, the principal kind the fake issuer handed out, *)
(* how fx login grok ended and what it saved, the token types fx sent to   *)
(* userinfo, the principal fields of its refresh, how fx ask ended, what   *)
(* grok-auth.json held at the end, and what it held after a killed fx.     *)
(*                                                                         *)
(* Runs are replayed in order. The index k advances only when the model    *)
(* has finished a run in exactly the observed way. The trace is ACCEPTED   *)
(* when TLC violates NotAllMatched, which is reachable only after every    *)
(* run matched. A completed search means REJECTED.                         *)
(***************************************************************************)
EXTENDS GrokIdentity, GrokIdentityObserved, Sequences

VARIABLE k
traceVars == <<vars, k>>

TraceInit ==
    /\ k = 1
    /\ InitWith(Observed[1].cmd, Observed[1].kind)

Step ==
    /\ k <= Len(Observed)
    /\ Next
    /\ UNCHANGED k

Matches(o) ==
    /\ phase = "done"
    /\ login = o.login
    /\ signedAs = o.signedAs
    /\ asked = o.asked
    /\ form = o.form
    /\ ask = o.ask
    /\ saved = o.saved
    /\ afterKill = o.afterKill

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed)
       THEN Begin(Observed[k + 1].cmd, Observed[k + 1].kind)
       ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
