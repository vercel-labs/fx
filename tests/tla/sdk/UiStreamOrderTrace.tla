------------------------- MODULE UiStreamOrderTrace -------------------------
(***************************************************************************)
(* Trace validation: replays what libfx's real durable code did to a World *)
(* and what a viewer saw through UiStreamOrder's own actions.              *)
(*                                                                         *)
(* UiStreamOrderObserved is generated by                                   *)
(* tests/tla/drivers/sdk/ui-order.ts. It defines Observed, the events of   *)
(* one run in the order they happened, each a record with every field      *)
(* below:                                                                  *)
(*                                                                         *)
(*   op      "issue" when libfx calls the World to write chunks,           *)
(*           "return" when that call settles, "deliver" when the viewer's  *)
(*           stream shows a line                                           *)
(*   chunks  for issue: the ids of the chunks in the call, in order        *)
(*   chunk   for deliver: the id of the chunk the line came from           *)
(*                                                                         *)
(* Chunk ids are 1, 2, 3, in the order libfx wrote the lines. The chunks   *)
(* landing, the writer producing a line, and the reader listing the        *)
(* stream are not observed, so the model takes them whenever it needs to.  *)
(* The index k advances only when the model takes the observed step. The   *)
(* run is ACCEPTED when TLC violates NotAllMatched, which is reachable     *)
(* only after every event matched. A completed search means REJECTED.      *)
(***************************************************************************)
EXTENDS UiStreamOrder, UiStreamOrderObserved

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ Init

\* Steps nobody observed.
Hidden ==
    \/ Push
    \/ \E c \in 1..Lines : Land(c)
    \/ List
    \/ (Read /\ got' = got)

Matches(e) ==
    CASE e.op = "issue" ->
            /\ Issue(Len(e.chunks))
            /\ call' = {e.chunks[i] : i \in 1..Len(e.chunks)}
      [] e.op = "return" -> Return
      [] e.op = "deliver" -> Read /\ got' = Append(got, e.chunk)

Step ==
    \/ /\ k <= Len(Observed)
       /\ Matches(Observed[k])
       /\ k' = k + 1
    \/ Hidden /\ UNCHANGED k

TraceSpec == TraceInit /\ [][Step]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
