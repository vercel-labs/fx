-------------------------- MODULE DurableSteerTrace --------------------------
(***************************************************************************)
(* Trace validation: replays the walks tests/tla/drivers/drive-steer.mjs   *)
(* took through real libfx with DurableSteer's own actions.                *)
(*                                                                         *)
(* DurableSteerObserved is generated by the driver. It defines Observed, a *)
(* sequence of walks, each a sequence of the driver's steps                *)
(* [name, m, seen, view]: the action the driver took and, when it read the *)
(* code after it (seen), what the code showed: the turns that started,     *)
(* each with its messages in the order the request holds them, the phase, *)
(* the messages the model got twice, and the running turn's messages in   *)
(* the request that carried the tool's result.                            *)
(*                                                                         *)
(* Between the driver's steps the worker may read the log on its own       *)
(* (Apply), and each walk starts a fresh session. The run is ACCEPTED when *)
(* TLC violates NotAllMatched, which is reachable only after every walk    *)
(* matched. A completed search means REJECTED.                             *)
(***************************************************************************)
EXTENDS DurableSteer, DurableSteerObserved

VARIABLES w, j, ok
traceVars == <<vars, w, j, ok>>

\* What the driver reads back from the code.
Shown == [turns |-> Started, phase |-> phase, twice |-> dup \cap Range(Flat(Started)), atTool |-> atTool]

TraceInit == Init /\ w = 1 /\ j = 0 /\ ok = TRUE

\* The driver's next step in walk w.
Step ==
    /\ w <= Len(Observed) /\ ok /\ j < Len(Observed[w])
    /\ Next
    /\ act'.name = Observed[w][j + 1].name
    /\ act'.m = Observed[w][j + 1].m
    /\ j' = j + 1
    /\ ok' = ~Observed[w][j + 1].seen
    /\ UNCHANGED w

\* The worker reads the log, and writes and lands its records, on its own,
\* between the driver's steps.
Read ==
    /\ w <= Len(Observed)
    /\ Apply \/ Write \/ Land \/ Expire
    /\ UNCHANGED <<w, j, ok>>

\* The code showed what the driver read after step j.
Check ==
    /\ w <= Len(Observed) /\ ~ok
    /\ Shown = Observed[w][j].view
    /\ ok' = TRUE
    /\ UNCHANGED <<vars, w, j>>

\* The next walk starts with a fresh session, as Init.
NextWalk ==
    /\ w <= Len(Observed) /\ ok /\ j = Len(Observed[w])
    /\ w' = w + 1
    /\ j' = 0
    /\ sent' = <<>> /\ turns' = <<>> /\ phase' = "idle" /\ queue' = <<>> /\ log' = <<>>
    /\ away' = {} /\ behind' = {} /\ worker' = FALSE
    /\ writing' = FALSE /\ writes' = 0 /\ held' = {} /\ late' = {}
    /\ retried' = {} /\ dup' = {} /\ preStart' = {}
    /\ tools' = 0 /\ handoffs' = 0 /\ cancels' = 0
    /\ missed' = {} /\ atTool' = <<>>
    /\ act' = [name |-> "Init", m |-> None]
    /\ UNCHANGED ok

TraceSpec == TraceInit /\ [][Step \/ Read \/ Check \/ NextWalk]_traceVars

\* Sentinel: violated exactly when every walk matched.
NotAllMatched == w <= Len(Observed)
=============================================================================
