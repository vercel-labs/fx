------------------------- MODULE QueueRecoveryTrace -------------------------
(***************************************************************************)
(* Trace validation: replays what the real SDK and world-local did across  *)
(* restarts through QueueRecovery's own actions.                           *)
(*                                                                         *)
(* QueueRecoveryObserved is generated by                                   *)
(* tests/tla/drivers/sdk/queue-recovery.ts. It defines Observed, the       *)
(* events of one scenario in order, each a record with every field below:  *)
(*                                                                         *)
(*   op        "create", "restart", "deliver", "turn" or "status"          *)
(*   run       the run, "s<n>" for a libfx session and "w<n>" for an app   *)
(*             run, or "none"                                              *)
(*   ns        for create: the namespace the World stored for the run      *)
(*   agents    for restart: "default" or "named"                           *)
(*   recover   for restart: whether the World recovered its runs           *)
(*   queued    for restart: the [run, topic] of every message it queued     *)
(*   consumer  for deliver: "libfx" or "workflow"                          *)
(*   outcome   for deliver and turn: what happened                         *)
(*   status    for status: the run's status in the World at the end        *)
(*                                                                         *)
(* and ObsLibfxRuns, ObsAppRuns and ObsRestarts for the constants. The     *)
(* index k advances only when the model takes the observed step. The run   *)
(* is ACCEPTED when TLC violates NotAllMatched, which is reachable only    *)
(* after every event matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS QueueRecovery, QueueRecoveryObserved, Sequences

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ Init

Queued(q) == {[run |-> m.run, topic |-> m.topic] : m \in q}

Matches(e) ==
    CASE e.op = "create" ->
            Create(e.run) /\ ns'[e.run] = e.ns
      [] e.op = "restart" ->
            Restart(e.agents, e.recover) /\ Queued(queue') = e.queued
      [] e.op = "deliver" ->
            /\ \E m \in queue : m.run = e.run /\ Deliver(m)
            /\ last' = [run |-> e.run, consumer |-> e.consumer, outcome |-> e.outcome]
      [] e.op = "turn" ->
            Turn(e.run) /\ last'.outcome = e.outcome
      [] e.op = "status" ->
            status[e.run] = e.status /\ UNCHANGED vars

Step ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1

TraceSpec == TraceInit /\ [][Step]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
