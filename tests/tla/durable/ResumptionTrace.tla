--------------------------- MODULE ResumptionTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays what real libfx did through Resumption's own *)
(* actions.                                                                *)
(*                                                                         *)
(* ResumptionObserved is generated by                                      *)
(* tests/tla/drivers/durable/resume_notice.ts. It defines Observed, a      *)
(* sequence of scenarios, each a sequence of records [a, run]: an action   *)
(* the driver saw a libfx process take, in order, and for a Request what   *)
(* that request carried of its open turn, as "step" and "notice" in the    *)
(* order the model saw them.                                               *)
(*                                                                         *)
(* Each scenario starts from Init; k is the scenario and i its next step.  *)
(* The run is ACCEPTED when TLC violates NotAllMatched, which is reachable *)
(* only after every scenario matched. A completed search means REJECTED.   *)
(***************************************************************************)
EXTENDS Resumption, ResumptionObserved

VARIABLES k, i
traceVars == <<vars, k, i>>

TraceInit == k = 1 /\ i = 1 /\ Init

Act(o) ==
    CASE o.a = "StartTurn"     -> StartTurn
      [] o.a = "Request"       -> Request /\ run = o.run
      [] o.a = "ToolStep"      -> ToolStep
      [] o.a = "Yield"         -> Yield
      [] o.a = "FinishReply"   -> FinishReply
      [] o.a = "SendEnd"       -> SendEnd
      [] o.a = "EndLands"      -> EndLands
      [] o.a = "ResolveResult" -> ResolveResult
      [] o.a = "Crash"         -> Crash
      [] o.a = "CleanExit"     -> CleanExit
      [] o.a = "Reopen"        -> Reopen

Step ==
    /\ k <= Len(Observed)
    /\ i <= Len(Observed[k])
    /\ Act(Observed[k][i])
    /\ i' = i + 1
    /\ UNCHANGED k

\* Resumption's Init in the next state, which TLC cannot write as Init'.
Reset ==
    /\ proc' = "running"
    /\ turn' = "none"
    /\ turns' = 0
    /\ crashesInTurn' = 0
    /\ autoResumes' = 0
    /\ asked' = FALSE
    /\ notices' = 0
    /\ delivered' = 0
    /\ badResume' = FALSE
    /\ crashes' = 0
    /\ reply' = "none"
    /\ ending' = FALSE
    /\ resolved' = FALSE
    /\ replySaved' = FALSE
    /\ askedAgain' = FALSE
    /\ earlyResult' = FALSE
    /\ saved' = <<>>
    /\ run' = <<>>
    /\ yielded' = FALSE
    /\ yields' = 0

\* The next scenario starts over in a fresh session.
Advance ==
    /\ k <= Len(Observed)
    /\ i = Len(Observed[k]) + 1
    /\ k' = k + 1
    /\ i' = 1
    /\ Reset

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every scenario matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
