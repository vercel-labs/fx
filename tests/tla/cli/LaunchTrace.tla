---------------------------- MODULE LaunchTrace ----------------------------
(***************************************************************************)
(* Trace validation: replays behavior observed from the real fx binary     *)
(* through LaunchSelection's own actions.                                  *)
(*                                                                         *)
(* LaunchObserved is generated by bun/bridge.ts. It defines Observed, a    *)
(* sequence of records                                                     *)
(*   [sc, orderFree, outcome, notices, req]                                *)
(* where sc is a LaunchSelection scenario, req is                          *)
(*   [present, model, indicator, wireFast, wireUltra, wireEffort]          *)
(* and indicator is "on", "off" or "unobserved" (the footer speed glyph at *)
(* submit time; fx ask has no footer).                                     *)
(*                                                                         *)
(* orderFree marks the early-submit race: the prompt and the catalog land  *)
(* together, so either interleaving may explain the observation.           *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* machine has finished a scenario in exactly the observed way. The run is *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS LaunchSelection, LaunchObserved, Sequences

VARIABLE k
traceVars == <<st, k>>

Starts(o) ==
  { Fresh([o.sc EXCEPT !.early = e]) : e \in (IF o.orderFree THEN BOOLEAN ELSE {o.sc.early}) }

IndicatorMatches(r, i) ==
  i = "unobserved" \/ ((r.claimedFast \/ r.claimedUltra) <=> (i = "on"))

ReqMatches(r, o) ==
  IF ~o.present
    THEN r.model = "none"
    ELSE /\ r.model = o.model
         /\ IndicatorMatches(r, o.indicator)
         /\ r.wireFast = o.wireFast
         /\ r.wireUltra = o.wireUltra
         /\ r.wireEffort = o.wireEffort

Matches(o) ==
  /\ Finished
  /\ st.outcome = o.outcome
  /\ st.notices = o.notices
  /\ ReqMatches(st.req, o.req)

TraceInit == k = 1 /\ st \in Starts(Observed[1])

Step ==
  /\ k <= Len(Observed)
  /\ (AskValidate \/ FirstFrame \/ CatalogReady \/ Send)
  /\ UNCHANGED k

Advance ==
  /\ k <= Len(Observed)
  /\ Matches(Observed[k])
  /\ k' = k + 1
  /\ IF k + 1 <= Len(Observed) THEN st' \in Starts(Observed[k + 1]) ELSE UNCHANGED st

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

(* Sentinel: violated exactly when every observation matched.               *)
NotAllMatched == k <= Len(Observed)
=============================================================================
