------------------------- MODULE ReviewPacketTrace -------------------------
(***************************************************************************)
(* Trace validation: replays automatic permission reviews observed from    *)
(* the real fx binary through ReviewPacket's own actions.                  *)
(*                                                                         *)
(* ReviewPacketObserved is generated by                                    *)
(* tests/tla/drivers/auto_classifier/driver.ts. It defines Observed, a     *)
(* sequence of records [provider, endpoint, packet, served, answers,       *)
(* context, outcome]: the reviewer edge and endpoint the run used, the     *)
(* shape of the review request fx sent, the endpoint's verdict on each     *)
(* review request, the reviewer's answers, what the reviewer's model       *)
(* context held, and whether the action ran or was held.                   *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has finished a review in exactly the observed way. The run is     *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS ReviewPacket, ReviewPacketObserved

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ InitWith(Observed[1].provider, Observed[1].endpoint, FALSE)

Reset(o) ==
    /\ provider' = o.provider
    /\ endpoint' = o.endpoint
    /\ emptyPassed' = FALSE
    /\ phase' = "pending"
    /\ packet' = <<>>
    /\ served' = <<>>
    /\ answers' = <<>>
    /\ context' = {}
    /\ outcome' = "none"

StepCompose == k <= Len(Observed) /\ Compose /\ UNCHANGED k

StepServe ==
    /\ k <= Len(Observed)
    /\ Len(served) < Len(Observed[k].served)
    /\ \E r \in RestoreChoices :
        /\ Serve(r)
        /\ served'[Len(served')] = Observed[k].served[Len(served) + 1]
    /\ UNCHANGED k

StepAnswer ==
    /\ k <= Len(Observed)
    /\ Len(answers) < Len(Observed[k].answers)
    /\ Answer(Observed[k].answers[Len(answers) + 1])
    /\ UNCHANGED k

StepDecide == k <= Len(Observed) /\ Decide /\ UNCHANGED k

Matches(o) ==
    /\ phase = "done"
    /\ packet = o.packet
    /\ served = o.served
    /\ answers = o.answers
    /\ context = o.context
    /\ outcome = o.outcome

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed) THEN Reset(Observed[k + 1]) ELSE UNCHANGED vars

TraceSpec ==
    TraceInit /\ [][StepCompose \/ StepServe \/ StepAnswer \/ StepDecide \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
