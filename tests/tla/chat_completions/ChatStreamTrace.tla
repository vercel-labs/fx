--------------------------- MODULE ChatStreamTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays replies that the real fx binary read through  *)
(* ChatStream's own actions.                                               *)
(*                                                                         *)
(* ChatStreamObserved is generated by                                      *)
(* tests/tla/drivers/chat_completions/driver.ts. It defines Observed, a    *)
(* sequence of records [events, outcome, error, usage]: the events the     *)
(* fake server sent in order, in ChatStream's terms, whether fx completed  *)
(* the reply or failed it, the error it named, and the completion tokens   *)
(* fx reported for the turn (0 when it reported none).                     *)
(*                                                                         *)
(* fx stops reading when it decides a reply, so the replay stops there     *)
(* too, and any events the server had left are never read. The index k    *)
(* advances only when the model decided a reply exactly as fx did and, for *)
(* a completed reply, kept the count fx reported. The run is ACCEPTED when *)
(* TLC violates NotAllMatched, which is reachable only after every         *)
(* observation matched. A completed search means REJECTED.                 *)
(***************************************************************************)
EXTENDS ChatStream, ChatStreamObserved, Sequences

VARIABLES k, i
traceVars == <<vars, k, i>>

TraceInit == k = 1 /\ i = 0 /\ Init

Step ==
    /\ k <= Len(Observed)
    /\ i < Len(Observed[k].events)
    /\ Send(Observed[k].events[i + 1])
    /\ i' = i + 1
    /\ UNCHANGED k

Matches(ob) ==
    /\ r.outcome = ob.outcome
    /\ (ob.outcome = "completed" \/ r.error = ob.error)
    /\ (ob.outcome = "failed" \/ r.usage = ob.usage)

Advance ==
    /\ k <= Len(Observed)
    /\ r.outcome # "pending"
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ i' = 0
    /\ r' = InitR
    /\ o' = InitO

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
