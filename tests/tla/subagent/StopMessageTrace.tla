--------------------------- MODULE StopMessageTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays one walk of the real fx binary through        *)
(* StopMessage's own actions.                                              *)
(*                                                                         *)
(* StopMessageObserved is generated by                                     *)
(* `tests/tla/drivers/subagent/stop-message.test.ts`. It defines Observed, *)
(* a sequence of records [op, sub, msg, answer, count, calls, msgs, note, *)
(* named, more]:                                                           *)
(*   "step"    main wrote a step whose calls are `calls`, a sequence of    *)
(*             [op, sub, msg];                                             *)
(*   "send", "stop", "close"                                               *)
(*             one call of that step ran, and main heard `answer`, with    *)
(*             the `count` of messages a stop or close dropped;            *)
(*   "rearm"   subagent `sub`'s end hook installed its next work and armed *)
(*             it: the slot is held there (FX_TEST_SUBAGENT_NEXT_HELD);    *)
(*   "begin"   subagent `sub`'s starting turn began: the driver let go of  *)
(*             its start hold (FX_TEST_SUBAGENT_START_HELD), and the turn  *)
(*             read the messages `msgs` that made it, if any did;          *)
(*   "read"    subagent `sub`'s running turn read the messages `msgs`;     *)
(*   "finish"  its turn ended with nothing more to read;                  *)
(*   "fail"    its turn ended without reading the messages that joined   *)
(*             it, and its slot kept them: the driver holds the slot     *)
(*             there (FX_TEST_SUBAGENT_RUN_HELD);                         *)
(*   "hook"    the end hook of that turn queued the kept messages as its  *)
(*             next work, to begin after a "rearm";                       *)
(*   "end"     its stopped or closed work ended, and the waiting messages  *)
(*             became its next work, to begin after a "rearm".            *)
(* A finish, hook or end carries `note`, what fx told main of it: "none" when it *)
(* queued no report, "idle" when its report said the subagent is idle,    *)
(* "plain" otherwise. A send carries `named`, the idle subagents its       *)
(* answer named, and `more`, how many it counted past them.                *)
(* The driver lists a step's answers in the order main wrote its calls. A  *)
(* step's calls to one subagent run in that order and calls to different   *)
(* subagents are independent, so the written order is always one the      *)
(* model allows; answers that only an order the model forbids explains     *)
(* match nothing. The driver sees every turn of every subagent, so no      *)
(* step of the model is hidden: none can be invented to explain a run.     *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the walk is not a behavior of the model.   *)
(***************************************************************************)
EXTENDS StopMessage, StopMessageObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

AsCalls(cs) == [x \in 1..Len(cs) |-> Call(cs[x].op, cs[x].sub, cs[x].msg, <<0, 0>>)]

\* A message's answer named the idle subagents the model names, or, when it
\* counted some past those it named, some of them and the right count.
NamedMatches(o) ==
  IF o.more = 0 THEN named' = o.named
  ELSE /\ o.named \subseteq named'
       /\ Cardinality(o.named) + o.more = Cardinality(named')

Observable(o) ==
  \/ /\ o.op = "step"
     /\ step = <<>>
     /\ steps < MaxSteps
     /\ Write(AsCalls(o.calls))
     /\ UNCHANGED <<phase, unread, waitq, read, dropped, toldDropped, told,
                    refusedOpen, coverBroken, lateStart>>
     /\ UNCHANGED heldVars
     /\ UNCHANGED idleVars
  \/ /\ o.op \in {"send", "stop", "close"}
     /\ Exec
     /\ last'.op = o.op
     /\ last'.sub = o.sub
     /\ last'.msg = o.msg
     /\ last'.answer = o.answer
     /\ last'.count = o.count
     /\ o.op = "send" => NamedMatches(o)
  \/ /\ o.op = "rearm"
     /\ Rearm(o.sub)
  \/ /\ o.op = "begin"
     /\ Begin(o.sub)
     /\ read' \ read = o.msgs
  \/ /\ o.op = "read"
     /\ Read(o.sub)
     /\ read' \ read = o.msgs
  \/ /\ o.op = "finish"
     /\ Finish(o.sub)
     /\ read' \ read = o.msgs
     /\ note' = o.note
  \/ /\ o.op = "fail"
     /\ Fail(o.sub)
  \/ /\ o.op = "hook"
     /\ Hook(o.sub)
     /\ note' = o.note
  \/ /\ o.op = "end"
     /\ EndStopped(o.sub)
     /\ read' \ read = o.msgs
     /\ note' = o.note

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0

TraceNext ==
  /\ k < Len(Observed)
  /\ Observable(Observed[k + 1])
  /\ k' = k + 1

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched == k < Len(Observed)
=============================================================================
