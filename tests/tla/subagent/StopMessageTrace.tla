--------------------------- MODULE StopMessageTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays one walk of the real fx binary through        *)
(* StopMessage's own actions.                                              *)
(*                                                                         *)
(* StopMessageObserved is generated by                                     *)
(* `tests/tla/drivers/subagent/stop-message.test.ts`. It defines Observed, *)
(* a sequence of records [op, sub, msg, answer, count, calls, msgs]:       *)
(*   "step"    main wrote a step whose calls are `calls`, a sequence of    *)
(*             [op, sub, msg];                                             *)
(*   "send", "stop", "close"                                               *)
(*             one call of that step ran, and main heard `answer`, with    *)
(*             the `count` of messages a stop or close dropped;            *)
(*   "begin"   subagent `sub`'s starting turn began: the driver let go of  *)
(*             its start hold (FX_TEST_SUBAGENT_START_HELD);               *)
(*   "read"    subagent `sub`'s running turn read the messages `msgs`;     *)
(*   "finish"  its turn ended with nothing more to read;                  *)
(*   "end"     its stopped or closed work ended, and its next turn read    *)
(*             the waiting messages `msgs` (none when nothing waited).     *)
(* The driver lists a step's answers in the order main wrote its calls. A  *)
(* step's calls to one subagent run in that order and calls to different   *)
(* subagents are independent, so the written order is always one the      *)
(* model allows; answers that only an order the model forbids explains     *)
(* match nothing. The driver sees every turn of every subagent, so no      *)
(* step of the model is hidden: none can be invented to explain a run.     *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the walk is not a behavior of the model.   *)
(***************************************************************************)
EXTENDS StopMessage, StopMessageObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

AsCalls(cs) == [x \in 1..Len(cs) |-> Call(cs[x].op, cs[x].sub, cs[x].msg, <<0, 0>>)]

Observable(o) ==
  \/ /\ o.op = "step"
     /\ step = <<>>
     /\ steps < MaxSteps
     /\ Write(AsCalls(o.calls))
     /\ UNCHANGED <<phase, unread, waitq, read, dropped, toldDropped, told,
                    refusedOpen, coverBroken, lateStart>>
  \/ /\ o.op \in {"send", "stop", "close"}
     /\ Exec
     /\ last'.op = o.op
     /\ last'.sub = o.sub
     /\ last'.msg = o.msg
     /\ last'.answer = o.answer
     /\ last'.count = o.count
  \/ /\ o.op = "begin"
     /\ Begin(o.sub)
  \/ /\ o.op = "read"
     /\ Read(o.sub)
     /\ read' \ read = o.msgs
  \/ /\ o.op = "finish"
     /\ Finish(o.sub)
     /\ read' \ read = o.msgs
  \/ /\ o.op = "end"
     /\ EndStopped(o.sub)
     /\ read' \ read = o.msgs

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0

TraceNext ==
  /\ k < Len(Observed)
  /\ Observable(Observed[k + 1])
  /\ k' = k + 1

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched == k < Len(Observed)
=============================================================================
