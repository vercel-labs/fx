--------------------------- MODULE QuietRelayTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays one walk of the real fx binary through        *)
(* QuietRelay's own actions.                                               *)
(*                                                                         *)
(* QuietRelayObserved is generated by                                      *)
(* `tests/tla/drivers/subagent/quiet-relay.test.ts`. It defines Observed,  *)
(* a sequence of records [op, sub, spell]:                                 *)
(*   "cross"   subagent `sub`'s wait ended early, with the notice: its     *)
(*             command crossed the quiet limit in spell `spell`;           *)
(*   "late"    its later wait in spell `spell` ran to its ceiling, with    *)
(*             the notice and no crossing;                                 *)
(*   "output"  its command printed, and spell `spell` began;               *)
(*   "close"   main closed it;                                             *)
(*   "note"    main read fx's note from it for spell `spell`.              *)
(* The relay's check and post, and main's wait and reads, are fx's own     *)
(* steps, which the driver does not see: any number of them may run        *)
(* between two observations. Each note is read once: `seen` holds the     *)
(* notes read, and a walk matches only when every note the model posted    *)
(* was read, so a note fx sent for a later notice, or twice, matches       *)
(* nothing.                                                                *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the walk is not a behavior of the model.   *)
(***************************************************************************)
EXTENDS QuietRelay, QuietRelayObserved

VARIABLES k, seen

traceVars == <<vars, k, seen>>

Hidden ==
    \/ \E c \in Children : RelayCheck(c) \/ RelayPost(c)
    \/ Register \/ Check \/ Read \/ ReadBusy

Visible(o) ==
    \/ /\ o.op = "cross"
       /\ spell[o.sub] = o.spell
       /\ Cross(o.sub)
       /\ UNCHANGED seen
    \/ /\ o.op = "late"
       /\ spell[o.sub] = o.spell
       /\ crossed[o.sub]
       /\ UNCHANGED <<vars, seen>>
    \/ /\ o.op = "output"
       /\ spell[o.sub] + 1 = o.spell
       /\ Output(o.sub)
       /\ UNCHANGED seen
    \/ /\ o.op = "close"
       /\ Close(o.sub)
       /\ UNCHANGED seen
    \/ /\ o.op = "note"
       /\ relays[o.sub][o.spell] > 0
       /\ <<o.sub, o.spell>> \notin seen
       /\ seen' = seen \cup {<<o.sub, o.spell>>}
       /\ UNCHANGED vars

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0 /\ seen = {}

TraceNext ==
    \/ /\ Hidden
       /\ UNCHANGED <<k, seen>>
    \/ /\ k < Len(Observed)
       /\ Visible(Observed[k + 1])
       /\ k' = k + 1

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched ==
    ~(/\ k = Len(Observed)
      /\ \A c \in Children : \A s \in Spells : (relays[c][s] > 0) = (<<c, s>> \in seen))
=============================================================================
