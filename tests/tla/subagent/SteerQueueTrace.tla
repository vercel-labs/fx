--------------------------- MODULE SteerQueueTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays events observed from the real fx binary       *)
(* through SteerQueue's own actions.                                       *)
(*                                                                         *)
(* SteerQueueObserved is generated by                                      *)
(* tests/tla/drivers/subagent/driver.ts. It defines Observed, a sequence   *)
(* of records [op, child, result]: what main or a subagent did, in order,  *)
(* and what fx answered, such as a message accepted into a running turn    *)
(* or refused.                                                             *)
(*                                                                         *)
(* Observations are replayed in order, each by the action of the same      *)
(* name, which must end with the observed result. The run is ACCEPTED when *)
(* TLC violates NotAllMatched, which is reachable only after every         *)
(* observation matched. A completed search means REJECTED.                 *)
(***************************************************************************)
EXTENDS SteerQueue, SteerQueueObserved, Sequences

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ Init

Act(o) ==
    CASE o.op = "start"  -> Start(o.child)
      [] o.op = "steer"  -> Steer(o.child)
      [] o.op = "read"   -> Read(o.child)
      [] o.op = "end"    -> End(o.child)
      [] o.op = "cancel" -> Cancel(o.child)
      [] o.op = "close"  -> Close(o.child)

TraceStep ==
    /\ k <= Len(Observed)
    /\ Act(Observed[k])
    /\ last'.result = Observed[k].result
    /\ k' = k + 1

TraceSpec == TraceInit /\ [][TraceStep]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
