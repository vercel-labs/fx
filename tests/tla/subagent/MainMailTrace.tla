---------------------------- MODULE MainMailTrace ----------------------------
(***************************************************************************)
(* Trace validation: replays one run of the real `fx ask` through          *)
(* MainMail's own actions.                                                 *)
(*                                                                         *)
(* MainMailObserved is generated by                                        *)
(* `tests/tla/drivers/subagent/main-mail.test.ts` from fx's trace, whose   *)
(* worker lines are written under the worker's lock, so their order is the *)
(* order the queue saw. It defines Observed, a sequence of records         *)
(* [op, m, joined, count, said]:                                           *)
(*   "user"    main's first turn began (`processing_begun`);               *)
(*   "post"    mail `m` reached main's queue, joining the running turn     *)
(*             when `joined` (`mail_posted`);                              *)
(*   "take"    a boundary of the running turn took `count` pieces of mail  *)
(*             (`steering_taken` with a count);                            *)
(*   "close"   a final boundary found none and closed the turn             *)
(*             (`steering_taken` closed=true);                             *)
(*   "abort"   the turn ended without closing;                             *)
(*   "finish"  the turn finished (`processing_finished`);                  *)
(*   "next"    the oldest waiting mail started main's next turn            *)
(*             (`queued_prompt_taken` marked=true);                        *)
(*   "wait"    wait answered that the mail follows or starts the next turn *)
(*             (`mail_joins_checked`).                                     *)
(* Every change to main's queue writes one of these lines, so no step of   *)
(* the model is hidden and none can be invented to explain a run.          *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the run is not a behavior of the model,   *)
(* and a violated rule means the run broke it.                             *)
(***************************************************************************)
EXTENDS MainMail, MainMailObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

Observable(o) ==
  \/ /\ o.op = "user"
     /\ UserTurn
  \/ /\ o.op = "post"
     /\ Post(o.m)
     /\ (queue'[Len(queue')].t # 0) = o.joined
  \/ /\ o.op = "take"
     /\ Len(Joined) = o.count
     /\ Take
  \/ /\ o.op = "close"
     /\ Close
  \/ /\ o.op = "abort"
     /\ Abort
  \/ /\ o.op = "finish"
     /\ Finish
  \/ /\ o.op = "next"
     /\ NextTurn
  \/ /\ o.op = "wait"
     /\ (IF Joined # <<>> THEN "follows" ELSE "next") = o.said
     /\ Wait

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0

TraceNext ==
  /\ k < Len(Observed)
  /\ Observable(Observed[k + 1])
  /\ k' = k + 1

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched == k < Len(Observed)
=============================================================================
