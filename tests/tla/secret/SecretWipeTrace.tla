-------------------------- MODULE SecretWipeTrace ---------------------------
(***************************************************************************)
(* Trace validation: checks one run of the built fx binary against        *)
(* SecretWipe.                                                              *)
(*                                                                         *)
(* SecretWipeObserved is generated by tests/tla/drivers/secret/driver.ts.  *)
(* It defines Observed, a record [frees, moves, secrets]: how many blocks  *)
(* fx gave back to libc while they still held one of the run's secrets,   *)
(* by free and by a realloc that moved them, as tests/tla/drivers/secret/  *)
(* scan.c saw them, and how many requests and saved sessions of the run    *)
(* carried a secret, as the fake issuers and the profile show.             *)
(*                                                                         *)
(* The run is ACCEPTED when TLC violates NotMatched, which is reachable    *)
(* only when the model, under the configured Policy, can handle a secret   *)
(* and give back exactly the observed blocks with secrets in them. A       *)
(* completed search means REJECTED.                                         *)
(***************************************************************************)
EXTENDS SecretWipe, SecretWipeObserved

TraceBounded ==
    /\ leaks["free"] <= Observed.frees
    /\ leaks["move"] <= Observed.moves
    /\ held <= Observed.frees + Observed.moves + 1

Matched ==
    /\ leaks["free"] = Observed.frees
    /\ leaks["move"] = Observed.moves
    /\ (Observed.secrets > 0 => held > 0)

\* Sentinel: violated exactly when the run is a behavior of the model.
NotMatched == ~Matched
=============================================================================
