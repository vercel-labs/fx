--------------------------- MODULE RemoteRunTrace ---------------------------
(***************************************************************************)
(* Trace validation: checks one observed run of the built-in remote runner *)
(* against RemoteRun's own actions.                                        *)
(*                                                                         *)
(* This checks the code in src/core/runner/vercel/. The                   *)
(* driver runs the built fx only with --next; --self-check checks          *)
(* hand-written observation sets.                                          *)
(*                                                                         *)
(* RemoteRunObserved is generated by tests/tla/drivers/runner/driver.ts.   *)
(* It defines Observed, the run's events in order. Each names the action  *)
(* and branch that gives it:                                               *)
(*   push_ok, push_failed                  PushOk, PushFails; PushMissing  *)
(*                                         and PushGone end with         *)
(*                                         push_failed; a repair and a     *)
(*                                         session end are silent; the one *)
(*                                         resume after a 404 or 410 is    *)
(*                                         resumed, and ResumeFirst (the   *)
(*                                         expiry resume) is silent        *)
(*   stop_before_send                      StopBeforeSend                  *)
(*   send_ran, send_not_run, send_failed,  Send: fully sent and the        *)
(*   send_gone                             command started, fully sent and *)
(*                                         it did not, failed before it    *)
(*                                         was fully sent, or answered 404 *)
(*                                         or 410 before its command line  *)
(*                                         with the one resume still to    *)
(*                                         come (send_gone)                *)
(*   id_arrives, no_id                     IdArrives, NoId                 *)
(*   cmd_edits, cmd_exits                  CmdEdits, CmdExits              *)
(*   cmd_deletes                           CmdDeletes                      *)
(*   bring_back_gone                       BringBack: tracked file gone    *)
(*   stream_end, idle_close                StreamEnds, IdleClose           *)
(*   reattach_ok, reattach_lost            Reattach                        *)
(*   bring_back_written, bring_back_kept,  BringBack: wrote the sandbox's  *)
(*   bring_back_nothing                    version, kept the Mac's, or had *)
(*                                         nothing to bring back           *)
(*   mac_edit, stop_requested              MacEdit, StopRequest            *)
(*   kill_sent, kill_failed                Kill, KillFails                 *)
(*   stop_exit                             StopExit, StopExitUnconfirmed   *)
(*   exit_cmd, exit_125, exit_143,         the runner's exit code: right   *)
(*   exit_255                              after the step that ends the    *)
(*                                         run; Unknown gives only this    *)
(*                                                                         *)
(* Every model step must match the next event. The run is ACCEPTED when   *)
(* TLC violates NotAllMatched, which is reachable only after every event  *)
(* matched and the run ended. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS RemoteRun, RemoteRunObserved, Sequences

VARIABLE k  \* the next event

traceVars == <<vars, k>>

TraceInit == Init /\ k = 1

Ends == phase # "done" /\ phase' = "done"
ExitEvent == "exit_" \o exit'

\* The step matches event e; a step that ends the run also matches the exit
\* code right after it.
Emit(e) ==
    /\ k <= Len(Observed)
    /\ Observed[k] = e
    /\ IF Ends
       THEN /\ k + 1 <= Len(Observed)
            /\ Observed[k + 1] = ExitEvent
            /\ k' = k + 2
       ELSE k' = k + 1

\* A step whose only sign is the exit code.
EmitExit ==
    /\ Ends
    /\ k <= Len(Observed)
    /\ Observed[k] = ExitEvent
    /\ k' = k + 1

TraceStep ==
    \/ PushOk /\ Emit("push_ok")
    \/ PushFails /\ Emit("push_failed")
    \/ PushMissing /\ (IF phase' = "done" THEN Emit("push_failed") ELSE k' = k)
    \/ PushGone /\ (IF phase' = "done" THEN Emit(IF phase = "start" THEN "push_failed" ELSE "send_failed") ELSE Emit("resumed"))
    \/ SessionEnds /\ k' = k
    \/ StopBeforeSend /\ Emit("stop_before_send")
    \/ ResumeFirst /\ k' = k
    \/ Send /\ Emit(CASE phase' = "done" -> "send_failed"
                      [] phase' = "pushed" -> "send_gone"
                      [] remoteCmd' = "running" -> "send_ran"
                      [] OTHER -> "send_not_run")
    \/ IdArrives /\ Emit("id_arrives")
    \/ NoId /\ Emit("no_id")
    \/ Unknown /\ EmitExit
    \/ CmdEdits /\ Emit("cmd_edits")
    \/ CmdDeletes /\ Emit("cmd_deletes")
    \/ CmdExits /\ Emit("cmd_exits")
    \/ StreamEnds /\ Emit("stream_end")
    \/ IdleClose /\ Emit("idle_close")
    \/ Reattach /\ Emit(IF phase' = "streaming" THEN "reattach_ok" ELSE "reattach_lost")
    \/ BringBack /\ Emit(CASE kind = "tracked" /\ remoteV = Gone -> "bring_back_gone"
                           [] RemoteChanged /\ ~Unchanged -> "bring_back_kept"
                           [] RemoteChanged -> "bring_back_written"
                           [] OTHER -> "bring_back_nothing")
    \/ MacEdit /\ Emit("mac_edit")
    \/ StopRequest /\ Emit("stop_requested")
    \/ Kill /\ Emit("kill_sent")
    \/ KillFails /\ Emit("kill_failed")
    \/ StopExit /\ Emit("stop_exit")
    \/ StopExitUnconfirmed /\ Emit("stop_exit")

TraceSpec == TraceInit /\ [][TraceStep]_traceVars

\* Sentinel: violated exactly when every event matched and the run ended.
NotAllMatched == ~(k = Len(Observed) + 1 /\ phase = "done")
=============================================================================
