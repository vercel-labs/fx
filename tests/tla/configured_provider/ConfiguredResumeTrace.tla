------------------------- MODULE ConfiguredResumeTrace -------------------------
(***************************************************************************)
(* Trace validation: replays resumes observed from the real fx binary      *)
(* through ConfiguredResume's own actions.                                 *)
(*                                                                         *)
(* ConfiguredResumeObserved is generated by                                *)
(* tests/tla/drivers/configured_provider/driver.ts. It defines Observed, a *)
(* sequence of records [saved, current, other, outcome, sent_to]: the      *)
(* binding the session was saved with, the connection's binding after the *)
(* edit (or [removed |-> TRUE]), whether a field outside the binding       *)
(* changed, what fx said, and the binding the resumed request reached (or  *)
(* [nothing |-> TRUE]).                                                    *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has resumed in exactly the observed way. The run is ACCEPTED when *)
(* TLC violates NotAllMatched, which is reachable only after every         *)
(* observation matched. A completed search means REJECTED.                *)
(***************************************************************************)
EXTENDS Naturals, ConfiguredResume, ConfiguredResumeObserved

VARIABLES k
traceVars == <<vars, k>>

TraceInit ==
    /\ k = 1
    /\ InitWith(Observed[1].saved)

Step ==
    /\ k <= Len(Observed)
    /\ UNCHANGED k
    /\ \/ /\ Observed[k].current # Removed
          /\ current # Observed[k].current
          /\ EditBinding(Observed[k].current)
       \/ /\ Observed[k].current = Removed
          /\ current # Removed
          /\ RemoveConnection
       \/ /\ Observed[k].other
          /\ ~other_edited
          /\ EditOther
       \/ /\ current = Observed[k].current
          /\ other_edited = Observed[k].other
          /\ Resume

Matches(o) ==
    /\ phase = "resumed"
    /\ outcome = o.outcome
    /\ sent_to = o.sent_to

Reset(b) ==
    /\ saved' = b
    /\ current' = b
    /\ other_edited' = FALSE
    /\ phase' = "editing"
    /\ outcome' = "pending"
    /\ sent_to' = Nothing

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed)
          THEN Reset(Observed[k + 1].saved)
          ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
