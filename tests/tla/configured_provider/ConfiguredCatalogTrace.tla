------------------------ MODULE ConfiguredCatalogTrace ------------------------
(***************************************************************************)
(* Trace validation: replays runs of `fx models` observed from the real fx *)
(* binary through ConfiguredCatalog's own actions.                         *)
(*                                                                         *)
(* ConfiguredCatalogObserved is generated by                               *)
(* tests/tla/drivers/configured_provider/driver.ts. It defines Observed, a *)
(* sequence of records [fetch, selected, server, asked, shown, lines]:     *)
(* each connection's fetch_models setting and the one fx ran on, how the   *)
(* fake server behaved ("lists", "refuses", or "silent"), every model list *)
(* request fx sent with the token it carried, the models fx listed, and    *)
(* how many failure lines it printed.                                      *)
(*                                                                         *)
(* One run is one load. Observations are replayed in order. The index k    *)
(* advances only when the model has settled in exactly the observed way.   *)
(* The run is ACCEPTED when TLC violates NotAllMatched, which is reachable *)
(* only after every observation matched. A completed search means          *)
(* REJECTED.                                                               *)
(***************************************************************************)
EXTENDS ConfiguredCatalog, ConfiguredCatalogObserved

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ InitWith(Observed[1].fetch, Observed[1].selected)

Step ==
    /\ k <= Len(Observed)
    /\ \/ Load
       \/ Observed[k].server = "lists" /\ Lists
       \/ Observed[k].server = "refuses" /\ Refuses
       \/ Observed[k].server = "silent" /\ (Tick \/ Deadline)
    /\ UNCHANGED k

Matches(o) ==
    /\ state = "ready"
    /\ ~InFlight
    /\ asked = o.asked
    /\ shown = o.shown
    /\ lines = o.lines

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed)
          THEN Reset(Observed[k + 1].fetch, Observed[k + 1].selected)
          ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
