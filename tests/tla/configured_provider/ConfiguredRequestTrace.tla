------------------------ MODULE ConfiguredRequestTrace ------------------------
(***************************************************************************)
(* Trace validation: replays sessions observed from the real fx binary     *)
(* through ConfiguredRequest's own actions.                                *)
(*                                                                         *)
(* ConfiguredRequestObserved is generated by                               *)
(* tests/tla/drivers/configured_provider/driver.ts. It defines Observed, a *)
(* sequence of records [def, configured, loaded, replies, sent, notices]:  *)
(* the model's metadata and the effort fx ran with, whether the settings   *)
(* loaded, the replies the fake server served in order, what each request  *)
(* fx sent carried, and how many ignored-effort notices fx showed.         *)
(*                                                                         *)
(* A turn starts whenever replies remain and fx is idle, so the replies    *)
(* give the turn boundaries: a turn ends at an "answer", or at a "cut" fx  *)
(* did not resend.                                                         *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has finished a session in exactly the observed way. The run is    *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS ConfiguredRequest, ConfiguredRequestObserved

VARIABLES k, used
traceVars == <<vars, k, used>>

TraceInit ==
    /\ k = 1
    /\ used = 0
    /\ InitWith(Observed[1].def, Observed[1].configured)

Step ==
    /\ k <= Len(Observed)
    /\ used < Len(Observed[k].replies)
    /\ \/ StartTurn /\ UNCHANGED used
       \/ Reply(Observed[k].replies[used + 1]) /\ used' = used + 1
    /\ UNCHANGED k

Matches(o) ==
    /\ used = Len(o.replies)
    /\ phase = "idle"
    /\ loaded = o.loaded
    /\ sent = o.sent
    /\ notices = o.notices

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ used' = 0
    /\ IF k + 1 <= Len(Observed)
          THEN Reset(Observed[k + 1].def, Observed[k + 1].configured)
          ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
