------------------------- MODULE ConfiguredAuthTrace -------------------------
(***************************************************************************)
(* Trace validation: replays runs of the real fx binary through            *)
(* ConfiguredAuth's own actions.                                           *)
(*                                                                         *)
(* ConfiguredAuthObserved is generated by                                  *)
(* tests/tla/drivers/configured_provider/driver.ts. It defines Observed, a *)
(* sequence of records [act, r, c, gen, reason]. act names the model       *)
(* action fx was seen to take (Begin, Replay, HelperPrints, HelperFails,   *)
(* Deadline, Accept, Reject, Revoke, Expire, Cancel), or a check that      *)
(* changes nothing: Sent, the token generation a request sent, and Ended,  *)
(* how a request ended. Fields an observation does not use hold "-" or 0.  *)
(*                                                                         *)
(* Observations are replayed in order, one model step each. The run is     *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.          *)
(***************************************************************************)
EXTENDS Naturals, Sequences, ConfiguredAuth, ConfiguredAuthObserved

VARIABLES k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ Init

\* What fx sent: the request is sending this token generation.
Sent(r, g) == phase[r] = "sending" /\ used[r].gen = g /\ UNCHANGED vars

\* How a request ended, and the reason fx gave.
Ended(r, why) ==
    /\ phase[r] \in {"done", "failed", "cancelled"}
    /\ reason[r] = why
    /\ UNCHANGED vars

Do(o) ==
    CASE o.act = "Begin"        -> Begin(o.r)
      [] o.act = "Replay"       -> Replay(o.r)
      [] o.act = "HelperPrints" -> HelperPrints(IF Design = "a" THEN o.r ELSE o.c)
      [] o.act = "HelperFails"  -> HelperFails(IF Design = "a" THEN o.r ELSE o.c)
      [] o.act = "Deadline"     -> Deadline(IF Design = "a" THEN o.r ELSE o.c)
      [] o.act = "Accept"       -> Accept(o.r)
      [] o.act = "Reject"       -> Reject(o.r)
      [] o.act = "Revoke"       -> Revoke(o.c)
      [] o.act = "Expire"       -> Expire(o.c)
      [] o.act = "Cancel"       -> Cancel(o.r)
      [] o.act = "Sent"         -> Sent(o.r, o.gen)
      [] o.act = "Ended"        -> Ended(o.r, o.reason)

Step ==
    /\ k <= Len(Observed)
    /\ Do(Observed[k])
    /\ k' = k + 1

TraceSpec == TraceInit /\ [][Step]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
