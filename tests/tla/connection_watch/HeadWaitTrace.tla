--------------------------- MODULE HeadWaitTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays requests observed from the real fx binary     *)
(* through HeadWait's own actions.                                         *)
(*                                                                         *)
(* HeadWaitObserved is generated by                                        *)
(* tests/tla/drivers/connection_watch/driver.ts. It defines Observed, a    *)
(* sequence of requests [deadline, sends]. `deadline` is 0 for an agent    *)
(* request and the request's own deadline in ticks otherwise. Each send is *)
(* [server, end, at]: whether the local server would answer it ("slow") or *)
(* never would ("hung"), how its head wait ended as the server saw it, and *)
(* the tick it ended at, rounded to the nearest 5 seconds:                 *)
(*   "head"           the server sent the head                             *)
(*   "closed"         the server closed the socket                         *)
(*   "esc"            fx closed it after the driver sent SIGINT            *)
(*   "client_closed"  fx closed it with no SIGINT                          *)
(* Consecutive sends of one request are recovery's resends.                *)
(*                                                                         *)
(* Requests are replayed in order. k advances only when the model has      *)
(* ended a request the observed way. The run is ACCEPTED when TLC violates *)
(* NotAllMatched, which is reachable only after every request matched. A   *)
(* completed search means REJECTED.                                        *)
(***************************************************************************)
EXTENDS HeadWait, HeadWaitObserved, Sequences

VARIABLES k, j
traceVars == <<vars, k, j>>

Obs == Observed[k]
Current == Obs.sends[j]

TraceInit ==
    /\ k = 1 /\ j = 1
    /\ InitWith(Observed[1].deadline, Observed[1].sends[1].server)

Live == k <= Len(Observed)

\* Time passes up to the moment the current send's wait was seen to end.
TraceTick == Live /\ clock < Current.at /\ Tick /\ UNCHANGED <<k, j>>

TraceEnd ==
    /\ Live /\ Waiting /\ clock = Current.at
    /\ CASE Current.end = "head" -> Head
         [] Current.end = "esc" -> Esc
         [] Current.end = "client_closed" -> Deadline \/ HeadTimeout
         [] Current.end = "closed" -> DieAs("closed")
    /\ UNCHANGED <<k, j>>

TraceReadFails == Live /\ ReadFails /\ UNCHANGED <<k, j>>

TraceGiveBack == Live /\ GiveBack /\ UNCHANGED <<k, j>>

TraceResend ==
    /\ Live /\ j < Len(Obs.sends)
    /\ ResendWith(Obs.sends[j + 1].server)
    /\ j' = j + 1 /\ UNCHANGED k

Finished(o) ==
    LET last == o.sends[Len(o.sends)].end IN
    CASE last = "head" -> phase = "done"
      [] last = "esc" -> phase = "cancelled"
      [] last = "client_closed" -> phase \in {"timed_out", "lost", "failed"}
      [] last = "closed" -> phase = "lost"

Advance ==
    /\ Live /\ j = Len(Obs.sends) /\ Finished(Obs)
    /\ k' = k + 1 /\ j' = 1
    /\ IF k + 1 <= Len(Observed)
          THEN ResetWith(Observed[k + 1].deadline, Observed[k + 1].sends[1].server)
          ELSE UNCHANGED vars

TraceSpec ==
    TraceInit /\ [][TraceTick \/ TraceEnd \/ TraceReadFails \/ TraceGiveBack \/ TraceResend \/ Advance]_traceVars

\* Sentinel: violated exactly when every request matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
