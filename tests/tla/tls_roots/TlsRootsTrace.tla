--------------------------- MODULE TlsRootsTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays runs of the real fx binary through TlsRoots'  *)
(* own actions.                                                            *)
(*                                                                         *)
(* TlsRootsObserved is generated by tests/tla/drivers/tls_roots/driver.ts. *)
(* It defines Observed, a sequence of records                              *)
(* [roots, system, pem, outcome, source]: how the run's sandbox left the   *)
(* two keychain files and /etc/ssl/cert.pem, how the request ended ("tls"  *)
(* when the server saw a handshake, "failed" when fx stopped before it     *)
(* connected), and which roots fx's trace log says it loaded ("keychain",  *)
(* "public_bundle", or "none").                                            *)
(*                                                                         *)
(* Each run is one request on one client on macOS. The index i advances    *)
(* only when the model has ended that request exactly as observed. The run *)
(* is ACCEPTED when TLC violates NotAllMatched, which is reachable only    *)
(* after every observation matched. A completed search means REJECTED.     *)
(***************************************************************************)
EXTENDS TlsRoots, TlsRootsObserved, Sequences

VARIABLE i
traceVars == <<vars, i>>

T == CHOOSE t \in Threads : TRUE

FilesOf(o) == [f \in Files |-> IF f = "roots" THEN o.roots ELSE o.system]

SourceOf(b) ==
    CASE b = {} -> "none"
      [] b = {"pem"} -> "public_bundle"
      [] b = {"roots", "system"} -> "keychain"
      [] OTHER -> "mixed"

TraceInit == i = 1 /\ InitWith("macos", FilesOf(Observed[1]), Observed[1].pem)

Step ==
    /\ i <= Len(Observed)
    /\ pc[T] \notin Done
    /\ Next
    /\ UNCHANGED i

Matches(o) ==
    /\ pc[T] = o.outcome
    /\ SourceOf(IF o.outcome = "tls" THEN seen[T] ELSE local[T]) = o.source

Advance ==
    /\ i <= Len(Observed)
    /\ Matches(Observed[i])
    /\ i' = i + 1
    /\ IF i + 1 <= Len(Observed)
         THEN ResetTo("macos", FilesOf(Observed[i + 1]), Observed[i + 1].pem)
         ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == i <= Len(Observed)
=============================================================================
