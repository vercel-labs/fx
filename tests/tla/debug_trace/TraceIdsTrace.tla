---------------------------- MODULE TraceIdsTrace ----------------------------
(***************************************************************************)
(* Trace validation: replays sessions observed from the real fx-term.wasm  *)
(* through TraceIds' own actions.                                          *)
(*                                                                         *)
(* TraceIdsObserved is generated by tests/tla/drivers/debug_trace/         *)
(* driver.ts. It defines Observed, a sequence of sessions, each a record:  *)
(*   script   the replies the mock gateway served, per turn: tool steps    *)
(*            [final |-> FALSE, n, before, after, streamed] and the final  *)
(*            answer [final |-> TRUE, ...]                                 *)
(*   screen   what the headless terminal showed under each prompt, as      *)
(*            TraceIds' Screen writes it                                   *)
(*   turnIds, stepIds  the ids fx's own trace lines gave each turn and     *)
(*            each step, in order                                          *)
(*                                                                         *)
(* Ids are compared by which of them are equal and whether any is 0, not   *)
(* by value. A session is replayed step by step; the index k advances only *)
(* when the model ends the session exactly as observed. The run is         *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every session matched. A completed search means REJECTED.               *)
(***************************************************************************)
EXTENDS TraceIds, TraceIdsObserved

VARIABLE k
traceVars == <<vars, k>>

Session == Observed[k]

TraceInit == k = 1 /\ Init

Replay ==
    /\ k <= Len(Observed)
    /\ \/ /\ phase = "idle"
          /\ turn < Len(Session.script)
          /\ StartTurn
       \/ /\ phase = "turn"
          /\ step + 1 <= Len(Session.script[turn])
          /\ LET e == Session.script[turn][step + 1] IN
                IF e.final THEN FinalStep ELSE ToolStep(e.n, e.before, e.after, e.streamed)
    /\ UNCHANGED k

\* The index of each id's first appearance: <<1, 2, 3>> for distinct ids,
\* <<1, 1, 1>> for one id handed out three times.
Canon(s) == [i \in 1..Len(s) |-> CHOOSE j \in 1..i : s[j] = s[i] /\ \A m \in 1..(j - 1) : s[m] /= s[i]]
HasZero(s) == \E i \in 1..Len(s) : s[i] = 0

Matches(o) ==
    /\ phase = "idle"
    /\ turn = Len(o.script)
    /\ Canon(turnIds) = Canon(o.turnIds)
    /\ Canon(stepIds) = Canon(o.stepIds)
    /\ HasZero(turnIds) = HasZero(o.turnIds)
    /\ HasZero(stepIds) = HasZero(o.stepIds)
    /\ Screen = o.screen

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Session)
    /\ k' = k + 1
    /\ Reset

TraceSpec == TraceInit /\ [][Replay \/ Advance]_traceVars

\* Sentinel: violated exactly when every session matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
