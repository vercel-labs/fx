------------------------ MODULE ResponseLanguageTrace ------------------------
(***************************************************************************)
(* Trace validation: replays turns observed from the real fx binary        *)
(* through ResponseLanguage's own actions.                                 *)
(*                                                                         *)
(* ResponseLanguageObserved is generated by                                *)
(* tests/tla/drivers/agent_runtime/response_language.ts. It defines        *)
(* Observed, a sequence of records [prompt, replies, sent, kept, outcome]: *)
(* the labeled prompt fx ran, the replies the fake gateway served in       *)
(* order, what each request fx sent carried, what fx kept of each reply,   *)
(* and how the turn ended.                                                 *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has finished a turn in exactly the observed way. The run is       *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS ResponseLanguage, ResponseLanguageObserved

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ InitWith(Observed[1].prompt)

Step ==
    /\ k <= Len(Observed)
    /\ Len(replies) < Len(Observed[k].replies)
    /\ Reply(Observed[k].replies[Len(replies) + 1])
    /\ UNCHANGED k

Matches(o) ==
    /\ phase = "done"
    /\ replies = o.replies
    /\ sent = o.sent
    /\ kept = o.kept
    /\ outcome = o.outcome

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed) THEN Reset(Observed[k + 1].prompt) ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
