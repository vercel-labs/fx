------------------------- MODULE RequestWrapperTrace -------------------------
(***************************************************************************)
(* Trace validation: replays tool calls observed from the real fx binary  *)
(* through RequestWrapper's own actions.                                   *)
(*                                                                         *)
(* RequestWrapperObserved is generated by                                  *)
(* tests/tla/drivers/agent_runtime/request-wrapper.ts. It defines          *)
(* Observed, a sequence of records [tool, action, shape, depth, ran,       *)
(* replay]: the tool a call named, the subagent action it asked for or     *)
(* "none", how its arguments were shaped, how deep their text nests,       *)
(* whether the tool ran it, and how the next request replayed it.          *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has finished a call in exactly the observed way. The run is       *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS RequestWrapper, RequestWrapperObserved, Sequences

VARIABLE k
traceVars == <<vars, k>>

TraceInit ==
    /\ k = 1
    /\ InitWith(Observed[1].tool, Observed[1].action, Observed[1].shape, Observed[1].depth)

Step ==
    /\ k <= Len(Observed)
    /\ (Run \/ Refuse \/ Replay)
    /\ UNCHANGED k

Matches(o) ==
    /\ phase = "done"
    /\ ran = o.ran
    /\ replay = o.replay

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed)
       THEN ResetTo(Observed[k + 1].tool, Observed[k + 1].action, Observed[k + 1].shape, Observed[k + 1].depth)
       ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
