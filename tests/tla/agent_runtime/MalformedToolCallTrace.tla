------------------------ MODULE MalformedToolCallTrace ------------------------
(***************************************************************************)
(* Trace validation: replays turns observed from the real fx binary        *)
(* through MalformedToolCall's own actions.                                *)
(*                                                                         *)
(* MalformedToolCallObserved is generated by                               *)
(* tests/tla/drivers/agent_runtime/malformed.ts. It defines Observed, a    *)
(* sequence of records [limit, replies, sent, tools, waited, outcome]: the *)
(* step limit fx ran with, the replies the fake gateway served in order,   *)
(* what each request fx sent carried, whether it went with tools on and    *)
(* after a wait, and how the turn ended.                                   *)
(*                                                                         *)
(* Observations are replayed in order. The index k advances only when the  *)
(* model has finished a turn in exactly the observed way. The run is       *)
(* ACCEPTED when TLC violates NotAllMatched, which is reachable only after *)
(* every observation matched. A completed search means REJECTED.           *)
(***************************************************************************)
EXTENDS MalformedToolCall, MalformedToolCallObserved

VARIABLE k
traceVars == <<vars, k>>

TraceInit == k = 1 /\ InitWith(Observed[1].limit)

Step ==
    /\ k <= Len(Observed)
    /\ Len(replies) < Len(Observed[k].replies)
    /\ Reply(Observed[k].replies[Len(replies) + 1])
    /\ UNCHANGED k

Matches(o) ==
    /\ phase = "done"
    /\ replies = o.replies
    /\ sent = o.sent
    /\ tools = o.tools
    /\ waited = o.waited
    /\ outcome = o.outcome

Advance ==
    /\ k <= Len(Observed)
    /\ Matches(Observed[k])
    /\ k' = k + 1
    /\ IF k + 1 <= Len(Observed) THEN Reset(Observed[k + 1].limit) ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
