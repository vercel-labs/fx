--------------------------- MODULE ToolArenaTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays turns observed from the real fx binary        *)
(* through ToolArena's own actions.                                        *)
(*                                                                         *)
(* ToolArenaObserved is generated by                                       *)
(* tests/tla/drivers/agent_runtime/tool_arena.ts. It defines Observed, a   *)
(* sequence of records [calls, kept]: each tool call of the turn in order, *)
(* as [kind, outcome, large], and what the turn kept of its large reads,   *)
(* "scratch" when fx's peak memory grew with the bytes those reads read,   *)
(* or "results" when it did not. The driver measures kept by running the   *)
(* same turn twice, once with large files and once with small ones.        *)
(*                                                                         *)
(* Observations are replayed in order. The index t advances only when the  *)
(* model has ended a turn in exactly the observed way, with nothing read   *)
(* after it was freed. The run is ACCEPTED when TLC violates               *)
(* NotAllMatched, which is reachable only after every observation matched. *)
(* A completed search means REJECTED.                                      *)
(***************************************************************************)
EXTENDS ToolArena, ToolArenaObserved

VARIABLE t
traceVars == <<vars, t>>

TraceInit == t = 1 /\ Init

Call(o, i) == o.calls[i]

Step ==
    /\ t <= Len(Observed)
    /\ \/ /\ n < Len(Observed[t].calls)
          /\ AdmitCall(Call(Observed[t], n + 1).kind,
                       Call(Observed[t], n + 1).outcome,
                       Call(Observed[t], n + 1).large)
       \/ Run
       \/ CopyOut
       \/ Settle
       \/ Free
       \/ (n = Len(Observed[t].calls) /\ EndTurn)
    /\ UNCHANGED t

Kept == IF largeScratch > 0 THEN "scratch" ELSE "results"

Matches(o) ==
    /\ phase = "ended"
    /\ n = Len(o.calls)
    /\ Kept = o.kept
    /\ ~readFreed
    /\ errorCode # "freed"

Advance ==
    /\ t <= Len(Observed)
    /\ Matches(Observed[t])
    /\ t' = t + 1
    /\ IF t + 1 <= Len(Observed) THEN Reset ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][Step \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == t <= Len(Observed)
=============================================================================
