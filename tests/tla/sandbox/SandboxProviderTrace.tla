------------------------ MODULE SandboxProviderTrace ------------------------
(***************************************************************************)
(* Trace validation: checks one shell call observed on the built fx, the   *)
(* a third-party provider, tests/tla/drivers/sandbox/provider-fixture.sh, *)
(* against                                                                 *)
(* SandboxProvider's own actions.                                          *)
(*                                                                         *)
(* SandboxProviderObserved is generated by                                 *)
(* tests/tla/drivers/sandbox/driver.ts. It defines Observed, one record:   *)
(*   placement, tty, ready, configured, grants   the call's inputs         *)
(*   events    the ordered timeline from the fake CLI's log and the        *)
(*             driver's own edit, stop, and crash steps                    *)
(*   result    what fx told the model, classified                         *)
(*   ranLocal  the command ran on this machine                             *)
(*   env       env names the sandbox got                                   *)
(*   conflict  the provider kept a local edit                              *)
(*   lost      a local edit was overwritten                                *)
(*   orphan    the remote command still ran when fx answered               *)
(*                                                                         *)
(* Steps the run cannot show (fx's decision, the sends and bring-backs,    *)
(* SIGKILL, ticks) are hidden and match any step. Every other step must    *)
(* produce the next event. The run is ACCEPTED when TLC violates           *)
(* NotAllMatched, which is reachable only after every event matched and    *)
(* the end state agrees. A completed search means REJECTED.                *)
(***************************************************************************)
EXTENDS SandboxProvider, SandboxProviderObserved, Sequences

VARIABLE k  \* the next event to match

traceVars == <<vars, k>>

Hidden == {"none", "decide", "local", "provider", "create", "createfail", "push", "copy", "keep", "cleanup",
           "nochange", "final", "rm", "termexit", "sigkill", "result", "tick"}

TraceInit ==
    /\ Init
    /\ placement = Observed.placement
    /\ tty = Observed.tty
    /\ ready = Observed.ready
    /\ configured = Observed.configured
    /\ grants = Observed.grants
    /\ k = 1

TraceStep ==
    /\ Next
    /\ IF ev' \in Hidden
       THEN k' = k
       ELSE /\ k <= Len(Observed.events)
            /\ ev' = Observed.events[k]
            /\ k' = k + 1

TraceSpec == TraceInit /\ [][TraceStep]_traceVars

Matched ==
    /\ k = Len(Observed.events) + 1
    /\ phase = "done"
    /\ result = Observed.result
    /\ ranLocal = Observed.ranLocal
    /\ env = Observed.env
    /\ conflict = Observed.conflict
    /\ lost = Observed.lost
    /\ (remote = "running") = Observed.orphan

\* Sentinel: violated exactly when the whole run matched.
NotAllMatched == ~Matched
=============================================================================
