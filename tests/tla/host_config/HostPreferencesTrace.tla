------------------------ MODULE HostPreferencesTrace ------------------------
(***************************************************************************)
(* Trace validation: replays runs observed from fx-term.wasm and the built *)
(* fx through HostPreferences' own actions.                                *)
(*                                                                         *)
(* HostPreferencesObserved is generated by                                 *)
(* tests/tla/drivers/host_config/driver.ts. It defines Observed, a         *)
(* sequence of runs [profile, home, steps]. Each step is [cmd, errors,     *)
(* saved, file, host, warned]: the command, then what the run showed so    *)
(* far: the labels of "not saved to global settings" notices, the labels   *)
(* of lines that claim a save, the labels whose keys settings.json holds,  *)
(* the keys the host config store holds, and whether this command showed  *)
(* the full-access warning.                                                *)
(*                                                                         *)
(* A step matches only when the model's command leaves exactly the         *)
(* observed values. The run is ACCEPTED when TLC violates NotAllMatched,   *)
(* which is reachable only after every step of every run matched. A        *)
(* completed search means REJECTED.                                        *)
(***************************************************************************)
EXTENDS HostPreferences, HostPreferencesObserved, Sequences

VARIABLES k, i
traceVars == <<vars, k, i>>

ResetTo(p, h) ==
    /\ profile' = p
    /\ home' = h
    /\ steps' = 0
    /\ attempted' = {}
    /\ errors' = {}
    /\ saved' = {}
    /\ settingsFile' = {}
    /\ touchedHome' = FALSE
    /\ hostStore' = {}
    /\ historyOn' = TRUE
    /\ yoloAck' = FALSE
    /\ yoloAttempted' = FALSE
    /\ lastWarned' = FALSE

TraceInit ==
    /\ k = 1
    /\ i = 0
    /\ InitWith(Observed[1].profile, Observed[1].home)

TraceStep ==
    /\ k <= Len(Observed)
    /\ i < Len(Observed[k].steps)
    /\ LET s == Observed[k].steps[i + 1] IN
          /\ Do(s.cmd)
          /\ errors' = s.errors
          /\ saved' = s.saved
          /\ settingsFile' = s.file
          /\ hostStore' = s.host
          /\ lastWarned' = s.warned
    /\ i' = i + 1
    /\ UNCHANGED k

Advance ==
    /\ k <= Len(Observed)
    /\ i = Len(Observed[k].steps)
    /\ k' = k + 1
    /\ i' = 0
    /\ IF k + 1 <= Len(Observed)
         THEN ResetTo(Observed[k + 1].profile, Observed[k + 1].home)
         ELSE UNCHANGED vars

TraceSpec == TraceInit /\ [][TraceStep \/ Advance]_traceVars

\* Sentinel: violated exactly when every observation matched.
NotAllMatched == k <= Len(Observed)
=============================================================================
