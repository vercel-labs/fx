---------------------------- MODULE LiveSessionsTrace ----------------------------
(***************************************************************************)
(* Trace validation: replays one run of the real fx binary through         *)
(* LiveSessions's own actions.                                             *)
(*                                                                         *)
(* LiveSessionsObserved is generated by                                    *)
(* `tests/tla/drivers/session/live.test.ts`. It defines TSessions, TProcs, *)
(* and TNames, and Observed, a sequence of records [op, p, s, n, listed]:  *)
(* op names the step the driver took or saw end (open, acquire, begin,     *)
(* end, spawn, finish, exit, crash, scan_start, scan_end), p the fx        *)
(* process, s the session, and n the subagent. For scan_end, listed is     *)
(* what `fx sessions --live --all --json` printed, as [id, working,        *)
(* agents] records with each agent as [name, st]. The scan's own steps     *)
(* between scan_start and scan_end are not observed; TLC finds them.       *)
(* Fields a step does not use are "none" or {}.                            *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the run is not a behavior of the model.    *)
(***************************************************************************)
EXTENDS LiveSessions, LiveSessionsObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

Printed(l) == {[id |-> e.id, working |-> e.working, agents |-> e.agents] : e \in l}

Step(o) ==
  CASE o.op = "open" -> Open(o.p, o.s)
    [] o.op = "acquire" -> Acquire(o.p)
    [] o.op = "begin" -> Begin(o.p)
    [] o.op = "end" -> End(o.p)
    [] o.op = "spawn" -> Spawn(o.p, o.n)
    [] o.op = "finish" -> Finish(o.p, o.n)
    [] o.op = "exit" -> Exit(o.p)
    [] o.op = "crash" -> Crash(o.p)
    [] o.op = "scan_start" -> ScanStart
    [] o.op = "scan_end" -> ScanEnd /\ Printed(scan'.listed) = o.listed

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0

TraceNext ==
  \/ /\ k < Len(Observed)
     /\ Step(Observed[k + 1])
     /\ k' = k + 1
  \/ /\ (\E s \in Sessions : Probe(s)) \/ Unlock \/ Peek
     /\ UNCHANGED k

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched == k < Len(Observed)
=============================================================================
