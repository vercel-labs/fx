---------------------------- MODULE PromptHistoryTrace ----------------------------
(***************************************************************************)
(* Trace validation: replays one run of the real fx binary through         *)
(* PromptHistory's own actions.                                            *)
(*                                                                         *)
(* PromptHistoryObserved is generated by                                   *)
(* `tests/tla/drivers/session/history-bridge.ts`. It defines the           *)
(* constants the run is checked against and Observed, a sequence of        *)
(* records [op, size, len, tail, torn]. The first is the seeded file       *)
(* (op "seed"); each later one is what the driver did (op "append",        *)
(* "duplicate", "torn" or "restart"), the size of the record or the torn   *)
(* bytes it brought, and what the history file held after it: its length,  *)
(* the sizes of its newest valid records, and the bytes after its last     *)
(* newline. The driver reads every field from the file fx wrote.           *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the run is not a behavior of the model.    *)
(***************************************************************************)
EXTENDS PromptHistory, PromptHistoryObserved

VARIABLE k

traceVars == <<vars, k>>

Match(o) == len = o.len /\ tail = o.tail /\ torn = o.torn

ASSUME Len(Observed) >= 1 /\ Observed[1].op = "seed"
ASSUME SeedOK(Observed[1].len, Observed[1].tail, Observed[1].torn)

TraceInit ==
  /\ InitFrom(Observed[1].len, Observed[1].tail, Observed[1].torn)
  /\ k = 1

(* The observation is bound before the step, so only the state is primed. *)
TraceNext ==
  /\ k < Len(Observed)
  /\ \E o \in {Observed[k + 1]} :
       /\ CASE o.op = "append" -> AppendRecord(o.size)
            [] o.op = "duplicate" -> Duplicate
            [] o.op = "torn" -> Torn(o.size)
            [] o.op = "restart" -> Restart
            [] OTHER -> FALSE
       /\ Match(o)'
  /\ k' = k + 1

NotAllMatched == k < Len(Observed)
=============================================================================
