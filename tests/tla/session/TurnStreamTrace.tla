--------------------------- MODULE TurnStreamTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays one agent turn of the real fx binary through *)
(* TurnStream's own actions.                                              *)
(*                                                                         *)
(* TurnStreamObserved is generated by `tests/tla/drivers/session/          *)
(* stream-bridge.ts`. It defines TOrder, the tool calls the driver issued, *)
(* in order, TMaxBuilds, and Observed, a sequence of records               *)
(*   [phase, stood, results, reparsed, least, arrived, calls, superseded]  *)
(* Each "stream" or "commit" record is one `sessions_v2_stream` line of    *)
(* fx's session trace: whether the open turn's pieces stood, how many tool *)
(* results the rebuild had, and how many streamed pieces samePiece had to  *)
(* parse. least and arrived bound the results the run had by then: the    *)
(* calls the driver issued before the request the decision followed, and   *)
(* before fx's next request. The last record,                              *)
(* "disk", is the session log fx left: the calls of the live turn's tool   *)
(* results, in order, and how many superseded markers it holds. Fields a   *)
(* record does not use are 0, FALSE or << >>.                              *)
(*                                                                         *)
(* Tool results arrive between records, in TOrder, as hidden RunTool      *)
(* steps, each with the stamp the turn gave it: a result that arrives      *)
(* without one is not a behavior of a real run. A compaction is a hidden   *)
(* Compact step, allowed only before a decision whose stream did not stand. *)
(* A real run injects no fault and does not recover, so Change, Drop and    *)
(* Recover never occur.                                                    *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the run is not a behavior of the model.    *)
(***************************************************************************)
EXTENDS TurnStream, TurnStreamObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

Decided(o) ==
  /\ last.phase = o.phase
  /\ last.stood = o.stood
  /\ last.results = o.results
  /\ last.reparsed = o.reparsed

OnDisk(o) ==
  /\ committed
  /\ LiveCalls = o.calls
  /\ supersedes = o.superseded

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0

(* The next result the run got arrives before the decision that counts it, *)
(* or before one that a compaction shifted.                                *)
Arrive(o) ==
  /\ o.phase \in {"stream", "commit"}
  /\ Len(done) - cut < o.results \/ ~o.stood
  /\ Len(done) < o.arrived
  /\ Len(done) < Len(TOrder)
  /\ RunTool(TOrder[Len(done) + 1], TRUE)
  /\ UNCHANGED k

(* A compaction before a decision whose stream no longer stood. *)
Cut(o) ==
  /\ o.phase \in {"stream", "commit"}
  /\ ~o.stood
  /\ \E n \in 1..Len(TOrder) : Compact(n)
  /\ UNCHANGED k

(* The observation is bound before the step, so only the state is primed. *)
Follow(o) ==
  /\ o.phase \in {"stream", "commit"}
  /\ Len(done) >= o.least
  /\ IF o.phase = "stream" THEN Stream ELSE Commit
  /\ Decided(o)'
  /\ k' = k + 1

Check(o) ==
  /\ o.phase = "disk"
  /\ OnDisk(o)
  /\ UNCHANGED vars
  /\ k' = k + 1

TraceNext ==
  /\ k < Len(Observed)
  /\ \E o \in {Observed[k + 1]} : Arrive(o) \/ Cut(o) \/ Follow(o) \/ Check(o)

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched == k < Len(Observed)
=============================================================================
