--------------------------- MODULE SessionWriteTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays one run of the real fx binary through        *)
(* SessionWrite's own actions, with one write of a session at a time.      *)
(*                                                                         *)
(* SessionWriteObserved is generated by                                    *)
(* `tests/tla/drivers/session/write.test.ts`. It defines TWriters,         *)
(* TMaxRecords, TMaxWrites and Observed, a sequence of records             *)
(*   [op, writer, count]                                                   *)
(* where op is "take" (a write took count due records: the session's      *)
(* write control wrote its marker), "land" (a batch listing count records  *)
(* landed in main's log, the compaction's line when writer is "main", a    *)
(* subagent's finish line when it is "child"), or "crash" (fx died). A     *)
(* take's writer is "main", "child", or "any" when the driver can't tell.  *)
(* Every other step of the model is hidden: the compactor keeping a        *)
(* record, a write that takes or lists no records, a clear that works, and *)
(* the lock.                                                               *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the run is not a behavior of the model.    *)
(***************************************************************************)
EXTENDS SessionWrite, SessionWriteObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

WritersOf(kind) ==
  CASE kind = "main" -> {Main}
    [] kind = "child" -> Writers \ {Main}
    [] OTHER -> Writers

Observable(o) ==
  \/ /\ o.op = "take"
     /\ \E w \in WritersOf(o.writer) : TakeDue(w) /\ Len(due'[w]) = o.count /\ o.count > 0
  \/ /\ o.op = "land"
     /\ \E w \in WritersOf(o.writer) : AppendBatch(w) /\ due[w] # <<>> /\ Len(due[w]) = o.count /\ Len(log') = Len(log) + 1
  \/ /\ o.op = "crash"
     /\ \E w \in Writers : Clear(w) /\ crashed'

Hidden ==
  \/ PutRecord
  \/ \E w \in Writers :
       \/ Begin(w)
       \/ TakeDue(w) /\ due'[w] = <<>>
       \/ AppendBatch(w) /\ due[w] = <<>>
       \/ Clear(w) /\ ~crashed'
       \/ Release(w)

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0

TraceNext ==
  \/ /\ k < Len(Observed)
     /\ Observable(Observed[k + 1])
     /\ k' = k + 1
  \/ /\ Hidden
     /\ UNCHANGED k

NotAllMatched == k < Len(Observed)
=============================================================================
