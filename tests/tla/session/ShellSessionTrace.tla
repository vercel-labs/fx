---------------------------- MODULE ShellSessionTrace ----------------------------
(***************************************************************************)
(* Trace validation: replays one profile's run of the real fx binary       *)
(* through ShellSession's own actions.                                     *)
(*                                                                         *)
(* ShellSessionObserved is generated by `tests/tla/drivers/session/        *)
(* bridge.ts`. It defines TIds and TMaxTurns, and Observed, a sequence of  *)
(* records                                                                 *)
(*   [op, id, point, saved, handoff, disk, turns]                          *)
(* where op names the action the driver took, id the session it opened or  *)
(* `/status` named, point a fork's prompt, saved what `/status` said,      *)
(* handoff the id the exit line named, disk the ids whose log was on disk  *)
(* after the step, and turns the turns each of those logs held. The driver *)
(* reads every field from fx's own output and files: the wiring trace, the *)
(* terminal replayed through fx's virtual terminal, the exit line, and the *)
(* session folders. Fields an action does not show are "none", 0 or FALSE. *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the run is not a behavior of the model.    *)
(***************************************************************************)
EXTENDS ShellSession, ShellSessionObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

DiskTurns == [i \in onDisk |-> turns[i]]

Match(o) ==
  /\ last = Obs(o.op, o.id, o.point, o.saved, o.handoff)
  /\ onDisk = o.disk
  /\ DiskTurns = o.turns

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0

(* The observation is bound before the step, so only the state is primed. *)
TraceNext ==
  /\ k < Len(Observed)
  /\ \E o \in {Observed[k + 1]} :
       /\ Next
       /\ Match(o)'
  /\ k' = k + 1

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched == k < Len(Observed)
=============================================================================
