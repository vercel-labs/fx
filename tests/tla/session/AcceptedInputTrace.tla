--------------------------- MODULE AcceptedInputTrace ---------------------------
(***************************************************************************)
(* Trace validation: replays one run of the real fx binary through         *)
(* AcceptedInput's Design "a2" actions.                                    *)
(*                                                                         *)
(* AcceptedInputObserved is generated by                                   *)
(* `tests/tla/drivers/session/accepted-input.test.ts`. It defines          *)
(* TMaxPrompts, TMaxCrashes, TMaxSwitches, and Observed, a sequence of     *)
(* records                                                                 *)
(*   [op, id, screen, composer, notices, acceptedIds, deliveredIds,        *)
(*    withdrawnIds, userItems, steeringItems, recoveryTurns, turnOpen]     *)
(* where acceptedIds, deliveredIds, withdrawnIds, userItems,               *)
(* steeringItems, and recoveryTurns come from the session log              *)
(* (`log.jsonl`). recoveryTurns are host resume items: the prompt a        *)
(* continued turn repeats after its `turn_continued` marker, or an old     *)
(* `<session_resumed>` turn. steeringItems leave out fx's resume notice.   *)
(* Screen comes from queued `┋` rows in the tmux pane, composer contents,  *)
(* notices from the scrollback notice banner, and turnOpen from the log's  *)
(* turn_started / turn_committed / turn_interrupted counts.                *)
(*                                                                         *)
(* NotAllMatched is a sentinel: TLC reports it violated (exit 12) only     *)
(* after every observation matched a step of the model. A search that ends *)
(* without that violation means the run is not a behavior of the model.    *)
(***************************************************************************)
EXTENDS AcceptedInput, AcceptedInputObserved, Sequences

VARIABLE k

traceVars == <<vars, k>>

LogAccepted(l) ==
    LET acc == SelectSeq(l, LAMBDA r : r.kind = "accepted")
    IN [i \in 1..Len(acc) |-> acc[i].id]

LogDelivered(l) ==
    {l[i].id : i \in {j \in 1..Len(l) : l[j].kind = "delivered"}}

LogWithdrawn(l) ==
    {l[i].id : i \in {j \in 1..Len(l) : l[j].kind = "withdrawn"}}

LogItemCount(l, t) ==
    Cardinality({i \in 1..Len(l) : l[i].kind = "item" /\ l[i].type = t})

Match(o) ==
    /\ screen = o.screen
    /\ composer = o.composer
    /\ notices = o.notices
    /\ LogAccepted(log) = o.acceptedIds
    /\ LogDelivered(log) = o.deliveredIds
    /\ LogWithdrawn(log) = o.withdrawnIds
    /\ LogItemCount(log, "user") + o.recoveryTurns = o.userItems
    /\ LogItemCount(log, "steering") = o.steeringItems
    /\ turnOpen = o.turnOpen

ASSUME Len(Observed) >= 1

TraceInit == Init /\ k = 0

Precursor(o) ==
    \/ /\ o.op = "turn_started"
       /\ \/ /\ o.id \notin submitted
             /\ IF composer # <<>> THEN SubmitFromComposer(o.id) ELSE Submit(o.id)
          \/ /\ o.id \in submitted
             /\ inFlight.kind = "none"
             /\ TurnStarts
    \/ /\ o.op = "show"
       /\ o.id \notin submitted
       /\ Submit(o.id)
    \/ /\ o.op = "boundary_commit"
       /\ \/ /\ inFlight.kind = "none" /\ memQueue # <<>> /\ Boundary
          \/ /\ inFlight.kind = "a_pop" /\ FinishDelivery
    \/ /\ o.op = "restart"
       /\ crashed
       /\ Restart
       /\ pendingRestoreWithdraw' # <<>>
    \/ /\ o.op = "resume"
       /\ ~crashed /\ ~inSession
       /\ ResumeSession
       /\ pendingRestoreWithdraw' # <<>>

Step(o) ==
    \/ /\ o.op = "turn_started"
       /\ inFlight.kind = "a_pop" /\ inFlight.id = o.id
       /\ FinishDelivery
    \/ /\ o.op = "show"
       /\ ShowAccepted(o.id)
    \/ /\ o.op = "boundary_commit"
       /\ CloseTurn
    \/ /\ o.op = "close_turn"
       /\ CloseTurn
    \/ /\ o.op = "withdraw"
       /\ Withdraw(o.id)
    \/ /\ o.op = "switch"
       /\ SessionSwitch
    \/ /\ o.op = "crash"
       /\ Crash
    \/ /\ o.op = "restart"
       /\ IF pendingRestoreWithdraw # <<>>
            THEN FinishRestoreWithdraw
            ELSE Restart /\ pendingRestoreWithdraw' = <<>>
    \/ /\ o.op = "resume"
       /\ IF pendingRestoreWithdraw # <<>>
            THEN FinishRestoreWithdraw
            ELSE ResumeSession /\ pendingRestoreWithdraw' = <<>>

TraceNext ==
    /\ k < Len(Observed)
    /\ \E o \in {Observed[k + 1]} :
         \/ (Precursor(o) /\ UNCHANGED k)
         \/ (Step(o) /\ Match(o)' /\ k' = k + 1)

TraceSpec == TraceInit /\ [][TraceNext]_traceVars

NotAllMatched == k < Len(Observed)
=============================================================================
