{
  "name": "libfx",
  "version": "0.0.0",
  "description": "Embed fx agents and terminals in JavaScript hosts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel-labs/fx.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/vercel-labs/fx/tree/main/sdk#readme",
  "bugs": "https://github.com/vercel-labs/fx/issues",
  "scripts": {
    "test:node-wasm": "node tests/test-node-wasm.mjs",
    "test:node-napi": "node tests/test-node-napi.mjs",
    "test:browser-wasm": "node tests/test-browser-wasm.mjs"
  },
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./types/node.d.ts",
          "default": "./node.js"
        },
        "require": {
          "types": "./types/node.d.cts",
          "default": "./node.cjs"
        }
      },
      "browser": {
        "types": "./types/browser.d.ts",
        "default": "./browser.js"
      },
      "default": {
        "types": "./types/browser.d.ts",
        "default": "./browser.js"
      }
    },
    "./node": {
      "import": {
        "types": "./types/node.d.ts",
        "default": "./node.js"
      },
      "require": {
        "types": "./types/node.d.cts",
        "default": "./node.cjs"
      }
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./browser.js"
    },
    "./wasm": {
      "types": "./types/wasm.d.ts",
      "default": "./fx-sdk.js"
    },
    "./durable-local": {
      "types": "./types/durable-local.d.ts",
      "default": "./durable/local.mjs"
    },
    "./durable-vercel": {
      "types": "./types/durable-vercel.d.ts",
      "default": "./durable/vercel.mjs"
    },
    "./durable-world": {
      "types": "./types/durable-world.d.ts",
      "default": "./durable/world.mjs"
    },
    "./chatgpt": {
      "types": "./types/chatgpt.d.ts",
      "default": "./chatgpt-sign-in.js"
    },
    "./grok": {
      "types": "./types/grok.d.ts",
      "default": "./grok-sign-in.js"
    },
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "default": "./mcp.js"
    },
    "./skills": {
      "types": "./types/skills.d.ts",
      "default": "./skills.js"
    },
    "./skills/node": {
      "types": "./types/skills-node.d.ts",
      "default": "./skills-node.js"
    }
  },
  "files": [
    "browser.js",
    "node.js",
    "node.cjs",
    "fx-sdk.js",
    "durable.js",
    "fx-harness.js",
    "durable/local.mjs",
    "durable/vercel.mjs",
    "durable/world.mjs",
    "types/*.d.ts",
    "types/*.d.cts",
    "wasm-module.js",
    "core-output.js",
    "subscription.js",
    "oauth.js",
    "chatgpt.js",
    "chatgpt-sign-in.js",
    "grok.js",
    "grok-sign-in.js",
    "custom-provider.js",
    "fetch-cleanup.js",
    "mcp.js",
    "skills.js",
    "skills-node.js",
    "fx-core.wasm",
    "fx-term.wasm",
    "*.node",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
